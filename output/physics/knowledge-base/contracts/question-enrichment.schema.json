{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "9702_question_enrichment_v2",
  "title": "Physics 9702 question enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enrichment_id",
    "question_id",
    "component",
    "difficulty",
    "question_patterns",
    "mapping",
    "parts"
  ],
  "properties": {
    "schema_version": { "const": "9702_question_enrichment_v2" },
    "enrichment_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "component": { "enum": ["P1", "P2"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "question_patterns": { "$ref": "#/$defs/questionPatterns" },
    "mapping": { "$ref": "#/$defs/questionMapping" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "questionPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "measurement_selection",
          "physical_quantity_estimation",
          "definition",
          "direct_calculation",
          "multi_step_calculation",
          "uncertainty_analysis",
          "graph_construction",
          "force_diagram_construction",
          "electric_field_line_construction",
          "vector_diagram_construction",
          "motion_path_representation",
          "graph_interpretation",
          "explanation",
          "comparison",
          "interference_analysis",
          "circuit_analysis",
          "circuit_diagram_construction",
          "equation_completion",
          "equation_derivation",
          "equation_recall",
          "classification",
          "property_identification",
          "particle_model_application"
        ]
      }
    },
    "questionMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_ids", "module_ids", "outcome_ids"],
      "properties": {
        "topic_ids": { "$ref": "#/$defs/idArray" },
        "module_ids": { "$ref": "#/$defs/idArray" },
        "outcome_ids": { "$ref": "#/$defs/idArray" }
      }
    },
    "partMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_topic_id", "primary_module_id", "outcome_ids"],
      "properties": {
        "primary_topic_id": { "type": "string", "minLength": 1 },
        "primary_module_id": { "type": "string", "minLength": 1 },
        "outcome_ids": { "$ref": "#/$defs/idArray" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_skill_id", "supporting_skill_ids"],
      "properties": {
        "primary_skill_id": { "type": "string", "minLength": 1 },
        "supporting_skill_ids": { "$ref": "#/$defs/idArray" }
      }
    },
    "knowledgeRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ids", "formula_ids"],
      "properties": {
        "definition_ids": { "$ref": "#/$defs/idArray" },
        "formula_ids": { "$ref": "#/$defs/idArray" },
        "formula_empty_justification": {
          "type": "string",
          "minLength": 1,
          "description": "Specific audit justification when a calculation-pattern part has no applicable major reusable syllabus formula."
        }
      }
    },
    "deterministicCheck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["field_id", "type"],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["exact", "single_choice", "multi_select", "numeric", "numeric_with_unit"]
        }
      }
    },
    "rubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "observable"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "criterion_occurrence": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based occurrence of the official mark-scheme part containing criterion_id. Required when canonical official_reconciliation binds this enrichment part to more than one occurrence of the same official part ID; omitted values remain backward-compatible and mean occurrence 1 for unambiguous single-occurrence parts."
        },
        "alternative_criterion_ids": {
          "$ref": "#/$defs/idArray",
          "description": "Official alternative routes to the same mark as criterion_id. Every alternative inherits criterion_occurrence."
        },
        "observable": { "type": "string", "minLength": 1 }
      }
    },
    "checking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "deterministic_checks",
        "full_marks_if_all_deterministic_checks_pass",
        "ai_rubric"
      ],
      "properties": {
        "mode": { "enum": ["deterministic", "ai", "hybrid"] },
        "deterministic_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/deterministicCheck" }
        },
        "full_marks_if_all_deterministic_checks_pass": { "type": "boolean" },
        "ai_rubric": {
          "type": "array",
          "items": { "$ref": "#/$defs/rubricItem" }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "difficulty",
        "question_patterns",
        "mapping",
        "skills",
        "knowledge_refs",
        "hints",
        "walkthrough",
        "checking"
      ],
      "properties": {
        "part_id": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "question_patterns": { "$ref": "#/$defs/questionPatterns" },
        "mapping": { "$ref": "#/$defs/partMapping" },
        "skills": { "$ref": "#/$defs/skills" },
        "knowledge_refs": { "$ref": "#/$defs/knowledgeRefs" },
        "hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "walkthrough": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "checking": { "$ref": "#/$defs/checking" }
      }
    }
  }
}
