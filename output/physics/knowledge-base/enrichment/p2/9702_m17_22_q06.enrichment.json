        "deterministic_checks": [],
        "full_marks_if_all_deterministic_checks_pass": false,
        "ai_rubric": [
          {
            "criterion_id": "9702_m17_22_q06_a_mp01",
            "observable": "States I = I₁ + I₂ + I₃."
          },
          {
            "criterion_id": "9702_m17_22_q06_a_mp02",
            "observable": "Uses the common p.d. and Ohm’s law to derive 1/R = 1/R₁ + 1/R₂ + 1/R₃."
          }
        ]
      }
    },
