      "hints": [
        "Stress is force distributed over area; first express force in SI base units."
      ],
      "walkthrough": [
        "Use stress = force/area.",
        "A newton is kg m s⁻² and area has unit m².",
        "Therefore stress has units (kg m s⁻²)/m² = kg m⁻¹ s⁻²."
      ],
      "checking": {
