      "hints": [
        "Express the unit of resistance using potential difference and current.",
        "One ohm is one volt per ampere."
      ],
      "walkthrough": [
        "Resistance is measured in ohms, with unit volt per ampere.",
        "Therefore 1 Ω = 1 V A⁻¹.",
        "Equivalently, an ohm is the resistance for which a potential difference of 1 V produces a current of 1 A."
      ],
      "checking": {
        "mode": "ai",
        "deterministic_checks": [],
        "full_marks_if_all_deterministic_checks_pass": false,
        "ai_rubric": [
          {
            "criterion_id": "9702_s19_23_q06_a_mp01",
            "observable": "Defines the ohm as volt per ampere, or as the resistance for which 1 V produces 1 A."
          }
        ]
      }
