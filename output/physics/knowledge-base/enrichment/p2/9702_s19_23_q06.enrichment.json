        "full_marks_if_all_deterministic_checks_pass": true,
        "ai_rubric": [
          {
            "criterion_id": "9702_s19_23_q06_b_i_mp02",
            "observable": "Uses 8.0 × 0.60 = 1.8(2.0 + R_Z), or an equivalent shared-potential-difference equation."
          },
          {
            "criterion_id": "9702_s19_23_q06_b_i_mp03",
            "observable": "Obtains R_Z = 0.67 Ω."
