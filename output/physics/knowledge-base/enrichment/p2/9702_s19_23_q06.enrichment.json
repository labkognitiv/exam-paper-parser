      "hints": [
        "The wires have the same material and length, so resistivity and length cancel in R = ρL / A.",
        "For these two wires, resistance is inversely proportional to cross-sectional area."
      ],
      "walkthrough": [
        "For each wire, R = ρL / A.",
        "As ρ and L are the same for X and Y, A_X / A_Y = R_Y / R_X.",
        "A_X / A_Y = 2.0 / 8.0 = 0.25.",
        "The cross-sectional-area ratio X / Y is 0.25."
      ],
      "checking": {
        "mode": "ai",
        "deterministic_checks": [],
        "full_marks_if_all_deterministic_checks_pass": false,
        "ai_rubric": [
