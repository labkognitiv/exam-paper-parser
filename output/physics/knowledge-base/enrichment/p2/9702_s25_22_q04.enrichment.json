      "hints": [
        "For an elastic collision, compare either total kinetic energy or the speeds before and after the collision."
      ],
      "walkthrough": [
        "The ball has the same mass before and after contact, but its speed decreases from 5.2 m s⁻¹ to 3.6 m s⁻¹.",
        "Since kinetic energy is proportional to v², its kinetic energy decreases during the collision.",
        "The collision is therefore inelastic; equivalently, the speed of approach is not equal to the speed of separation."
      ],
      "checking": {
        "mode": "ai",
        "deterministic_checks": [],
        "full_marks_if_all_deterministic_checks_pass": false,
        "ai_rubric": [
