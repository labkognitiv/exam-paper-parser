      "marking_points": [
        {
          "id": "9702_s24_23_q05_a_i_mp01",
          "text": "sum of electromotive force(s) = sum of potential difference(s) around a (closed) loop or the (algebraic) sum of the p.d.(s) and e.m.f.(s) is zero around a (closed) loop",
          "tag": "B1",
          "marks": 1,
          "is_alternative": false
        }
      ]
    },
    {
      "id": "9702_s24_23_q05_a_ii",
      "label": "(a)(ii)",
      "marks": 1,
      "marking_points": [
        {
          "id": "9702_s24_23_q05_a_ii_mp01",
          "text": "(law of conservation of) energy",
          "tag": "B1",
          "marks": 1,
          "is_alternative": false
        }
      ]
    },
    {
      "id": "9702_s24_23_q05_b_i",
      "label": "(b)(i)",
      "marks": 2,
      "marking_points": [
        {
          "id": "9702_s24_23_q05_b_i_mp01",
          "text": "(by Kirchhoff’s first law) I = I1 + I2",
          "tag": "B1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s24_23_q05_b_i_mp02",
          "text": "V / RT = V / R1 + V / R2 therefore 1 / RT = 1 / R1 + 1 / R2",
          "tag": "B1",
          "marks": 1,
          "is_alternative": false
        }
      ]
    },
    {
      "id": "9702_s24_23_q05_b_ii",
      "label": "(b)(ii)",
      "marks": 3,
      "marking_points": [
        {
          "id": "9702_s24_23_q05_b_ii_mp01",
          "text": "resistance of parallel combination = (15 × 10) / (15 + 10) (= 6.0 Ω)",
          "tag": "C1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp02",
          "text": "r = (E – V) / I",
          "tag": "C1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp03",
          "text": "I= 1.38 / 6.0 = 0.23 A r = (1.50 – 1.38) / 0.23 = 0.52 Ω",
          "tag": "A1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp04",
          "text": "or (by potential divider principle) r / RT = Ir / V",
          "tag": "C1",
          "marks": 1,
          "is_alternative": true
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp05",
          "text": "r / 6.0 = 0.12 / 1.38 r = 0.52 Ω",
          "tag": "A1",
          "marks": 1,
          "is_alternative": true
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp06",
          "text": "or (by potential divider equation) V = E × RT / (RT + r)",
          "tag": "C1",
          "marks": 1,
          "is_alternative": true
        },
        {
          "id": "9702_s24_23_q05_b_ii_mp07",
          "text": "1.38 = 1.5 × 6.0 / (6.0 + r) r = 0.52 Ω",
          "tag": "A1",
          "marks": 1,
          "is_alternative": true
        }
      ]
    },
    {
      "id": "9702_s24_23_q05_c_i",
      "label": "(c)(i)",
      "marks": 2,
      "marking_points": [
        {
          "id": "9702_s24_23_q05_c_i_mp01",
          "text": "as the (total) resistance has decreased (and e.m.f. is unchanged)",
          "tag": "M1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s24_23_q05_c_i_mp02",
          "text": "current will (in the cell) increase",
          "tag": "A1",
          "marks": 1,
          "is_alternative": false
        }
      ]
    },
    {
