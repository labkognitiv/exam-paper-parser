        {
          "id": "9702_s16_21_q01_b_mp01",
          "text": "density = mass / volume or ρ = M / V",
          "tag": "C1",
          "marks": 1,
          "is_alternative": false
        },
        {
          "id": "9702_s16_21_q01_b_mp02",
          "text": "V = [π(0.38 × 10–3)2 × 25.0 × 10–2] / 4 (= 2.835 × 10–8 m3)",
