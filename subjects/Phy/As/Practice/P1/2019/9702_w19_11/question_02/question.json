{
  "stem": [
    {
      "type": "text",
      "text": "The speed of a wave in deep water depends on its wavelength $L$ and the acceleration of free fall $g$."
    },
    {
      "type": "text",
      "text": "What is a possible equation for the speed $v$ of the wave?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$v = \\sqrt{\\dfrac{gL}{2\\pi}}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$v = \\dfrac{gL}{4\\pi^{2}}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$v = 2\\pi\\sqrt{\\dfrac{g}{L}}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$v = \\dfrac{2\\pi g}{L}$"
      }
    ]
  }
}
