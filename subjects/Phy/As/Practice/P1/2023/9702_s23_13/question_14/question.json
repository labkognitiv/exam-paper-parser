    {
      "type": "text",
      "text": "An object is falling at a constant speed through a viscous liquid. $F_\\text{U}$ is the upthrust on the object due to the liquid. $W_\\text{L}$ is the weight of the liquid displaced by the object. $W_\\text{O}$ is the weight of the object."
    },
    {
      "type": "text",
      "text": "Which equation **must** be correct?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$F_\\text{U} = W_\\text{L}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$F_\\text{U} = W_\\text{O} - W_\\text{L}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$F_\\text{U} = W_\\text{O}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$F_\\text{U} = W_\\text{O} + W_\\text{L}$"
      }
    ]
  }
