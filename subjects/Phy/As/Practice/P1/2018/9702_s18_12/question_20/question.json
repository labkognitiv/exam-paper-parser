{
  "stem": [
    {
      "type": "text",
      "text": "An elastic material with Young modulus $E$ is subjected to a tensile stress $S$. Hooke’s law is obeyed."
    },
    {
      "type": "text",
      "text": "What is the expression for the elastic energy stored per unit volume of the material?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{E}{2S^{2}}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{2E}{S^{2}}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{S^{2}}{E}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{S^{2}}{2E}$"
      }
    ]
  }
}
