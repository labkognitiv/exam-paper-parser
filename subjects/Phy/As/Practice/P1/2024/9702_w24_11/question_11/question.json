    {
      "type": "text",
      "text": "A stationary ball of mass $m$ is hit by a bat. The ball leaves the bat with velocity $v$."
    },
    {
      "type": "text",
      "text": "The bat is in contact with the ball for a short time $\\Delta t$."
    },
    {
      "type": "text",
      "text": "What is the average force of the bat on the ball?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$mv\\Delta t$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{mv}{\\Delta t}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{1}{2}mv^{2}\\Delta t$"
      }
    ],
    "D": [
