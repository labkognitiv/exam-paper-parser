{
  "stem": [
    {
      "type": "text",
      "text": "A spring is fixed at one end and extended by applying force $F$ to the other end. The spring has extension $x$ and elastic potential energy $E_\\text{P}$. The spring constant is $k$."
    },
    {
      "type": "text",
      "text": "The spring obeys Hooke’s law."
    },
    {
      "type": "text",
      "text": "Which relationship is correct for this spring?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$E_\\text{P} \\propto F$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$E_\\text{P} \\propto x$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$E_\\text{P} \\propto k$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$E_\\text{P} \\propto x^{2}$"
      }
    ]
  }
