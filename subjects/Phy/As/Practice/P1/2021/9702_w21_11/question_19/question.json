{
  "stem": [
    {
      "type": "text",
      "text": "A metal wire, of cross-sectional area $A$ and unstretched length $l$, is subjected to stress $\\sigma$. As a result it has strain $\\varepsilon$."
    },
    {
      "type": "text",
      "text": "Which expression gives the Young modulus of the metal?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{\\varepsilon}{\\sigma}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{\\varepsilon A}{\\sigma l}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{\\sigma}{\\varepsilon}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{\\sigma l}{\\varepsilon A}$"
      }
    ]
  }
}
