{
  "stem": [
    {
      "type": "text",
      "text": "A constant force pushes a block along a horizontal frictionless surface. The block moves from rest through a fixed distance."
    },
    {
      "type": "text",
      "text": "What is the relationship between the final speed $v$ of the block and its mass $m$?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\sqrt{v} \\propto \\dfrac{1}{m}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$v \\propto \\sqrt{m}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$v \\propto \\dfrac{1}{\\sqrt{m}}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\sqrt{v} \\propto m$"
      }
    ]
  }
}
