{
  "stem": [
    {
      "type": "text",
      "text": "The total energy input $E_\\text{in}$ in a process is partly transferred to useful energy output $U$ and partly transfered to energy that is wasted $W$."
    },
    {
      "type": "text",
      "text": "What is the efficiency of the process?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{U}{E_\\text{in}} \\times 100\\%$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{W}{E_\\text{in}} \\times 100\\%$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{U}{W} \\times 100\\%$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{U + W}{E_\\text{in}} \\times 100\\%$"
      }
    ]
  }
}
