{
  "stem": [
    {
      "type": "text",
      "text": "A mass is raised vertically. In time $t$, the increase in its gravitational potential energy is $E_\\text{p}$ and the increase in its kinetic energy is $E_\\text{k}$."
    },
    {
      "type": "text",
      "text": "What is the average power input to the mass?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$(E_\\text{p} - E_\\text{k})t$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$(E_\\text{p} + E_\\text{k})t$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{E_\\text{p} - E_\\text{k}}{t}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{E_\\text{p} + E_\\text{k}}{t}$"
      }
    ]
  }
}
