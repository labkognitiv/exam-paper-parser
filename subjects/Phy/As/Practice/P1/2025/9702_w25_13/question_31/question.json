{
  "stem": [
    {
      "type": "text",
      "text": "There is a potential difference $V$ across a resistor of resistance $R$. The current in the resistor is $I$."
    },
    {
      "type": "text",
      "text": "Which equation gives the power $P$ dissipated by the resistor?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$P = V^{2}I$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$P = \\dfrac{V^{2}}{I}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$P = V^{2}R$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$P = \\dfrac{V^{2}}{R}$"
      }
    ]
  }
}
