{
  "stem": [
    {
      "type": "text",
      "text": "A wire of length $L_0$ is attached at one end to a fixed point. A tensile force is applied to the other end so that the wire extends and has a new length $L_1$."
    },
    {
      "type": "text",
      "text": "What is the strain of the wire?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\left(\\dfrac{L_1}{L_0}\\right) - 1$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$L_1 - L_0$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\left(\\dfrac{L_1}{L_0}\\right) + 1$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$L_1 + L_0$"
      }
    ]
  }
}
