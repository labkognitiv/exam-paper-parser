{
  "stem": [
    {
      "type": "text",
      "text": "A uniform metal wire of length $L$ and diameter $d$ has spring constant $k$."
    },
    {
      "type": "text",
      "text": "What is the Young modulus of the metal?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{\\pi d^{2}}{4kL}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{\\pi d^{2}}{kL}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{kL}{\\pi d^{2}}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{4kL}{\\pi d^{2}}$"
      }
    ]
  }
