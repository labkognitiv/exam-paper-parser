{
  "stem": [
    {
      "type": "text",
      "text": "The momentum of a car of mass $m$ increases from $p_1$ to $p_2$."
    },
    {
      "type": "text",
      "text": "What is the increase in the kinetic energy of the car?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{(p_2^{2} - p_1^{2})}{2m}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{(p_2 - p_1)^{2}}{2m}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{p_2 - p_1}{2m}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{p_1 - p_2}{2m}$"
      }
    ]
  }
}
