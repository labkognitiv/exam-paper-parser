{
  "stem": [
    {
      "type": "text",
      "text": "A motor is used to lift a load vertically upwards."
    },
    {
      "type": "text",
      "text": "The load has weight $W$."
    },
    {
      "type": "text",
      "text": "The motor produces useful power output $P$."
    },
    {
      "type": "text",
      "text": "The load is lifted at constant velocity $v$."
    },
    {
      "type": "text",
      "text": "Which expression gives the time taken for the motor to lift the load vertically upwards through a distance $d$?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\dfrac{P}{Wd}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$\\dfrac{Wv}{P}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\dfrac{Wd}{P}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\dfrac{Pv}{W}$"
      }
    ]
  }
}
