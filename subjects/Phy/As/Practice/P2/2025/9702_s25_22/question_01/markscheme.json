  "9702_s25_22_q01_b_i": {
    "points": [
      {
        "mark": "1",
        "text": "$W = Fs$ or $W = mas$",
        "guidance": "Official B1."
      },
      {
        "mark": "1",
        "text": "$s = v^{2} / 2a$ or $a = v^{2} / 2s$ or $as = v^{2} / 2$",
        "guidance": "Official B1."
      },
      {
        "mark": "1",
        "text": "$W = ma(v^{2} / 2a)$ or $W = m(v^{2} / 2s)s$ or $W = m(v^{2} / 2)$ and (so $E_{K}$) $= \\frac{1}{2}mv^{2}$",
        "guidance": "Official B1."
      }
    ],
    "alternatives": [
      {
        "label": "Alternative method 1",
        "points": [
          {
            "mark": "1",
            "text": "OR $W = Fs$ or $W = mas$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$F = mv / t$ and $s = \\frac{1}{2}vt$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$W = mv / t \\times \\frac{1}{2}vt$ and (so $E_{K}$) $= \\frac{1}{2}mv^{2}$",
            "guidance": "Official B1."
          }
        ]
      },
      {
        "label": "Alternative method 2",
        "points": [
          {
            "mark": "1",
            "text": "OR $W = Fs$ or $W = mas$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$a = v / t$ and $s = \\frac{1}{2}vt$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$W = m(v / t)(\\frac{1}{2}vt)$ and (so $E_{K}$) $= \\frac{1}{2}mv^{2}$",
            "guidance": "Official B1."
          }
        ]
      },
      {
        "label": "Alternative method 3",
        "points": [
          {
            "mark": "1",
            "text": "OR $W = Fs$ or $W = mas$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$a = v / t$ and $s = \\frac{1}{2}at^{2}$",
            "guidance": "Official B1."
          },
          {
            "mark": "1",
            "text": "$W = m(v / t)(\\frac{1}{2} \\times (v / t) \\times t^{2})$ and (so $E_{K}$) $= \\frac{1}{2}mv^{2}$",
            "guidance": "Official B1."
          }
        ]
      }
    ]
