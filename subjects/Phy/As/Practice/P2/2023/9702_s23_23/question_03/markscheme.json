  },
  "9702_s23_23_q03_b_i": {
    "points": [
      {
        "mark": "B1",
        "text": "$3m \\times 4 = m \\times v \\sin \\theta$ ($v \\sin \\theta = 12$)"
      },
      {
        "mark": "B1",
        "text": "$2m \\times 6 = m \\times v \\cos \\theta$ ($v \\cos \\theta = 12$)"
      },
      {
        "mark": "B1",
        "text": "therefore $\\sin \\theta = \\cos \\theta$ or $\\tan \\theta = 1$, $\\theta = 45^{\\circ}$"
      }
    ]
  },
  "9702_s23_23_q03_b_ii": {
    "points": [
      {
        "mark": "M1",
        "text": "$mv \\times \\cos 45^{\\circ} = 12m$ or $mv \\times \\sin 45^{\\circ} = 12m$ or $(mv)^{2} = (3m \\times 4)^{2} + (2m \\times 6)^{2}$"
      },
      {
        "mark": "A1",
        "text": "$v = 17 \\text{ m s}^{-1}$"
      }
    ]
  },
  "9702_s23_23_q03_c_i": {
    "points": [
      {
        "mark": "B1",
        "text": "(chemical energy) $= 0.0050 \\times 700 = 3.5$ (J) or (chemical energy) $= 5.0 \\times 0.700 = 3.5$ (J)"
