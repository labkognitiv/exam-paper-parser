{
  "9702_s16_21_q06_a": {
    "points": [
      {
        "mark": "B1",
        "text": "(coulomb is) ampere second"
      }
    ]
  },
  "9702_s16_21_q06_b": {
    "points": [
      {
        "mark": "M1",
        "text": "(total) charge or $Q = nAle$"
      },
      {
        "mark": "M1",
        "text": "$I = Q/t$ and $l/t = v$"
      },
      {
        "mark": "A1",
        "text": "$I = nAle/t = nAve$ therefore $v = I/nAe$"
      }
    ]
  },
  "9702_s16_21_q06_c_i": {
    "points": [
      {
        "mark": "C1",
        "text": "ratio $= (I/nA_{Y}e)/(I/nA_{Z}e)$"
      },
      {
        "mark": "C1",
        "text": "$= A_{Z}/A_{Y}$ or $4A/A$ or $\\pi d^{2}/(\\pi d^{2}/4)$"
      },
      {
        "mark": "A1",
        "text": "$= 4$"
      }
    ]
  },
  "9702_s16_21_q06_c_ii": {
    "points": [
      {
        "mark": "B1",
        "text": "$R = \\rho l/A$ or $R = 4\\rho l/\\pi d^{2}$"
      },
      {
        "mark": "A1",
        "text": "$R_{Y} = \\rho l/A$ and $R_{Z} = \\rho(2l)/4A$ so $R_{Y}/R_{Z} = 2$ or $R_{Y} = 4\\rho l/\\pi d^{2}$ and $R_{Z} = 4\\rho(2l)/\\pi 4d^{2}$ or $2\\rho l/\\pi d^{2}$ so $R_{Y}/R_{Z} = 2$"
      }
    ]
  },
  "9702_s16_21_q06_c_iii": {
    "points": [
      {
        "mark": "C1",
        "text": "$V = 12R_{Y}/(R_{Y} + R_{Z})$ or $I = 12/(R_{Y} + R_{Z})$ and $V = IR_{Y}$"
      },
      {
        "mark": "A1",
        "text": "$V = 12 \\times 2/3$ $= 8(.0)\\text{ V}$"
      }
    ]
  },
  "9702_s16_21_q06_c_iv": {
    "points": [
      {
        "mark": "A1",
        "text": "ratio $= I^{2}R_{Y}/I^{2}R_{Z}$ or $(V_{Y}^{2}/R_{Y})/(V_{Z}^{2}/R_{Z})$ or $(V_{Y}I)/(V_{Z}I)$ $= 2$"
      }
    ]
  }
}
