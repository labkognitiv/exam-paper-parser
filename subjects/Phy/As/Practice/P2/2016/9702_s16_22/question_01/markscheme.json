      {
        "mark": "B1",
        "text": "acceleration = change in velocity / time (taken) or rate of change of velocity"
      }
    ]
  },
  "9702_s16_22_q01_b_i": {
    "points": [
      {
        "mark": "C1",
        "text": "$v = 0 + at$ or $v = at$"
      },
      {
        "mark": "A1",
        "text": "$(a = 36 / 19 =) 1.9 (1.8947) \\text{ m s}^{-2}$"
      }
    ]
  },
  "9702_s16_22_q01_b_ii": {
    "points": [
      {
        "mark": "M1",
        "text": "$s = \\frac{1}{2}(u + v)t$ or $s = v^{2} / 2a$ or $s = \\frac{1}{2}at^{2}$ $= \\frac{1}{2} \\times 36 \\times 19$ $= 36^{2} / (2 \\times 1.89)$ $= \\frac{1}{2} \\times 1.89 \\times 19^{2}$ $= 340 \\text{ m}$ (342 m / 343 m / 341 m)"
      }
    ]
  },
  "9702_s16_22_q01_b_iii_1": {
    "points": [
      {
        "mark": "C1",
        "text": "1. $(\\Delta KE =) \\frac{1}{2} \\times 95 \\times (36)^{2}$"
      },
      {
        "mark": "A1",
        "text": "$= 62000 (61560) \\text{ J}$"
      }
    ]
  },
  "9702_s16_22_q01_b_iii_2": {
    "points": [
      {
        "mark": "C1",
        "text": "2. $(\\Delta PE =) 95 \\times 9.81 \\times 340 \\sin 40^{\\circ}$ or $95 \\times 9.81 \\times 218.5$"
      },
      {
        "mark": "A1",
        "text": "$= 200000 \\text{ J}$"
      }
    ]
  },
  "9702_s16_22_q01_b_iv": {
    "points": [
      {
        "mark": "C1",
        "text": "work done (by frictional force) = $\\Delta PE - \\Delta KE$ or work done $= 200000 - 62000$ (values from 1b(iii) 1. and 2.)"
