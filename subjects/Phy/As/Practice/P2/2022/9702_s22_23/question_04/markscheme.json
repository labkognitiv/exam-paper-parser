        "mark": "M1",
        "text": "$P = I^{2}R$ or $IV$ or $V^{2} / R$"
      },
      {
        "mark": "A1",
        "text": "$= 0.09^{2} \\times 47$ or $0.09 \\times 4.23$ or $4.23^{2} / 47$ $= 0.38\\text{ W}$"
      }
    ]
  },
  "9702_s22_23_q04_c_iii": {
