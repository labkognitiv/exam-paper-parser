    "points": [
      {
        "mark": "M1",
        "text": "$P = mg(\\Delta)h / (\\Delta)t$ or $Fv$"
      },
      {
        "mark": "A1",
        "text": "$P = (0.60 \\times 9.81 \\times 1.4) / 4.0$ or $0.60 \\times 9.81 \\times (1.4 / 4.0)$ $= 2.1\\text{ W}$"
      }
    ]
  },
  "9702_s22_23_q04_c_ii": {
