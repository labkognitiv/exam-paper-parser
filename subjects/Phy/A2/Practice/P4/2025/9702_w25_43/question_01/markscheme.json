        "mark": "A1",
        "text": "$v = R\\omega$"
      }
    ]
  },
  "9702_w25_43_q01_b_ii": {
    "points": [
      {
        "mark": "C1",
        "text": "$a = R\\omega^2$ or $a = v^2 / R$"
      },
      {
        "mark": "A1",
        "text": "$a = v\\omega$"
      }
    ]
  },
  "9702_w25_43_q01_c_i": {
    "points": [
      {
        "mark": "A1",
        "text": "$x = R \\sin \\theta$"
      }
    ]
  },
  "9702_w25_43_q01_c_ii": {
    "points": [
      {
        "mark": "A1",
        "text": "$\\theta = \\omega t$"
      }
    ]
  },
  "9702_w25_43_q01_c_iii": {
    "points": [
      {
        "mark": "A1",
        "text": "clear substitution of $\\theta = \\omega t$ into $x = R \\sin \\theta$ leading to $x = R \\sin \\omega t$"
      }
    ]
  },
  "9702_w25_43_q01_c_iv": {
    "points": [
      {
        "mark": "B1",
        "text": "equation is of the form $x = x_0 \\sin \\omega t$ (so simple harmonic motion)"
      }
    ]
  },
  "9702_w25_43_q01_d_i": {
    "points": [
      {
        "mark": "A1",
        "text": "amplitude $= 0.46 / 2$ $= 0.23 \\text{ m}$"
      }
    ]
  },
  "9702_w25_43_q01_d_ii": {
    "points": [
      {
        "mark": "C1",
        "text": "$\\omega = 2\\pi / T$"
      },
      {
        "mark": "A1",
