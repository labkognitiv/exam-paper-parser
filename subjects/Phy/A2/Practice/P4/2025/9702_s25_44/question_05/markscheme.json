        "mark": "B1",
        "text": "work done per unit charge"
      },
      {
        "mark": "B1",
        "text": "work done (on charge) in moving positive charge from infinity (to the point)"
      }
    ]
  },
  "9702_s25_44_q05_b_i": {
    "points": [
      {
        "mark": "C1",
        "text": "electric field strength inversely proportional to distance^2"
      },
      {
        "mark": "A1",
        "text": "E = 3^2 × 2.0 × 10^5 = 1.8 × 10^6 N C^-1"
      }
    ]
  },
  "9702_s25_44_q05_b_ii": {
    "points": [
      {
        "mark": "B1",
        "text": "V = Q / 4πε0 r and E = Q / 4πε0 r^2 (so E = V / r)"
      },
      {
        "mark": "A1",
        "text": "r = (9.0 × 10^4) / (1.8 × 10^6) = 0.050 m = 5.0 cm"
      }
    ]
  },
  "9702_s25_44_q05_b_iii": {
    "points": [
      {
        "mark": "C1",
        "text": "Q = 4πε0 V r = 4π × 8.85 × 10^-12 × 9.0 × 10^4 × 0.050"
      },
      {
        "mark": "A1",
        "text": "= 5.0 × 10^-7 C"
      }
    ]
  },
  "9702_s25_44_q05_b_iv": {
    "points": [
      {
        "mark": "C1",
        "text": "C = Q / V"
      },
      {
        "mark": "A1",
        "text": "= (5.0 × 10^-7) / (9.0 × 10^4) = 5.6 × 10^-12 F"
      }
    ]
  }
