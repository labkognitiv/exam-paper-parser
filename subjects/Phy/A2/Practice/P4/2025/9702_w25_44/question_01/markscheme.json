        "mark": "B1",
        "text": "(gravitational) force is (directly) proportional to product of masses"
      },
      {
        "mark": "B1",
        "text": "force (between point masses) is inversely proportional to the square of their separation"
      }
    ]
  },
  "9702_w25_44_q01_b_i": {
    "points": [
      {
        "mark": "C1",
        "text": "$force = (6.67 \\times 10^{-11} \\times 4.0 \\times 10^{30} \\times 2.0 \\times 10^{30}) / (3.3 \\times 10^{12})^2$"
      },
      {
        "mark": "A1",
        "text": "$= 4.9 \\times 10^{25} \\text{ N}$"
      }
    ]
  },
  "9702_w25_44_q01_b_ii": {
    "points": [
      {
        "mark": "A1",
        "text": "$a = F / m = (4.9 \\times 10^{25}) / (4.0 \\times 10^{30})$ $= 1.2 \\times 10^{-5} \\text{ m s}^{-2}$"
      }
    ]
  },
  "9702_w25_44_q01_b_iii": {
    "points": [
      {
        "mark": "C1",
        "text": "$a = r\\omega^2$ and $\\omega = 2\\pi / T$ or $a = v^2 / r$ and $v = (2\\pi r / T)$"
      },
      {
        "mark": "C1",
        "text": "$r = (3.3 \\times 10^{12}) / 3$"
      },
      {
        "mark": "A1",
        "text": "$T = 2\\pi [(3.3 \\times 10^{12}) / (3 \\times 1.2 \\times 10^{-5})]^{1/2}$ $= 1.9 \\times 10^{9} \\text{ s}$"
      }
    ]
  },
  "9702_w25_44_q01_b_iv": {
