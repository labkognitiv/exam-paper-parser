{
  "9702_w24_41_q01_a": {
    "points": [
      {
        "mark": "B1",
        "text": "(gravitational) force is (directly) proportional to product of masses"
      },
      {
        "mark": "B1",
        "text": "force (between point masses) is inversely proportional to the square of their separation"
      }
    ]
  },
  "9702_w24_41_q01_b_i": {
    "points": [
      {
        "mark": "B1",
        "text": "(gravitational) force acts perpendicular to direction of motion"
      },
      {
        "mark": "B1",
        "text": "gravitational force provides centripetal acceleration"
      }
    ]
  },
  "9702_w24_41_q01_b_ii": {
    "points": [
      {
        "mark": "M1",
        "text": "($F$ =) $GMm / x^2 = mx\\omega^2$ and $\\omega = 2\\pi / T$ or $GMm / x^2 = 4\\pi^2mx / T^2$"
      },
      {
        "mark": "A1",
        "text": "completion of algebra leading to $x^3 = GMT^2 / 4\\pi^2$"
      },
      {
        "mark": "B1",
        "text": "clear indication that $B$ = radius of planet and that $A$ = mass (of planet)"
      }
    ]
  },
  "9702_w24_41_q01_b_iii": {
    "points": [
      {
        "mark": "C1",
        "text": "gradient = $\\sqrt[3]{(4\\pi^2 / GA)}$"
      },
      {
        "mark": "C1",
        "text": "e.g. $(1280 - 360) / (12 \\times 10^6) = \\sqrt[3]{(4\\pi^2 / [6.67 \\times 10^{-11} \\times A])}$"
      },
      {
        "mark": "A1",
        "text": "$A = 1.3 \\times 10^{24} \\text{ kg}$"
      },
      {
        "mark": "C1",
        "text": "intercept = gradient $\\times$ $B$"
      },
      {
        "mark": "A1",
        "text": "e.g. $360 = ((1280 - 360) \\times B) / (12 \\times 10^6)$ $B = 4.7 \\times 10^6 \\text{ m}$"
      }
    ]
  }
}
