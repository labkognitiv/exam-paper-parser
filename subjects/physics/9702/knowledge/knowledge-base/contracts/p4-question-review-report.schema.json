{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p4-question-review-report.schema.json",
  "title": "Physics 9702 P4 per-question independent review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper", "question", "role", "verdict", "author_id", "manager_id", "reviewer_id",
    "reviewed_leaves", "physics_reviewed_leaves", "hint_reviewed_leaves", "rubric_reviewed_leaves",
    "registry_ids_checked", "source_evidence", "review_summary", "semantic_findings", "deterministic_findings"
  ],
  "properties": {
    "paper": {"type": "string", "pattern": "^9702_[msw][0-9]{2}_4[1-4]$"},
    "question": {"type": "integer", "minimum": 1},
    "role": {"enum": ["question_verifier", "external_auditor"]},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "author_id": {"type": "string", "minLength": 1},
    "manager_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_leaves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "physics_reviewed_leaves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "hint_reviewed_leaves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rubric_reviewed_leaves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "registry_ids_checked": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_question_pdf", "question_pdf_page", "original_mark_scheme_pdf", "mark_scheme_pdf_page", "canonical_question", "official_mark_scheme"],
      "properties": {
        "original_question_pdf": {"type": "string", "minLength": 1},
        "question_pdf_page": {"type": "integer", "minimum": 1},
        "original_mark_scheme_pdf": {"type": "string", "minLength": 1},
        "mark_scheme_pdf_page": {"type": "integer", "minimum": 1},
        "canonical_question": {"type": "string", "minLength": 1},
        "official_mark_scheme": {"type": "string", "minLength": 1}
      }
    },
    "review_summary": {"type": "string", "minLength": 80},
    "semantic_findings": {"type": "array", "items": {"type": "string"}},
    "deterministic_findings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{
    "if": {"properties": {"verdict": {"const": "PASS"}}},
    "then": {"properties": {"semantic_findings": {"maxItems": 0}, "deterministic_findings": {"maxItems": 0}}}
  }]
}
