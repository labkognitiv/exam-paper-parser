{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "9702_knowledge_registries_v1",
  "title": "Physics 9702 shared knowledge record definitions",
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "term", "accepted_definition", "topic_ids", "evidence_question_ids"],
      "properties": {
        "definition_id": { "type": "string", "minLength": 1 },
        "term": { "type": "string", "minLength": 1 },
        "accepted_definition": { "type": "string", "minLength": 1 },
        "accepted_alternatives": { "type": "array", "items": { "type": "string" } },
        "topic_ids": { "$ref": "#/$defs/evidenceIds" },
        "evidence_question_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula_id", "name", "latex", "topic_ids", "evidence_question_ids"],
      "properties": {
        "formula_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "latex": { "type": "string", "minLength": 1 },
        "variables": { "type": "object", "additionalProperties": { "type": "string" } },
        "topic_ids": { "$ref": "#/$defs/evidenceIds" },
        "evidence_question_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "name", "description", "topic_ids", "evidence_question_ids"],
      "properties": {
        "skill_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "topic_ids": { "$ref": "#/$defs/evidenceIds" },
        "evidence_question_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    }
  }
}
