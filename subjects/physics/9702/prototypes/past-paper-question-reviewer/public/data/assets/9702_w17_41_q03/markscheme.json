          "tag": "1",
          "text": "gravitational force provides/is centripetal force",
          "guidance": null
        },
        {
          "tag": "2",
          "text": "$GMm/r^{2} = mv^{2}/r$",
          "guidance": null
        },
        {
          "tag": "3",
          "text": "$v = (2\\pi \\times 1.5 \\times 10^{11})/(3600 \\times 24 \\times 365) = 2.99 \\times 10^{4}$ $(\\text{m s}^{-1})$",
          "guidance": null
        },
        {
          "tag": "4",
          "text": "$6.67 \\times 10^{-11}M = 1.5 \\times 10^{11} \\times (2.99 \\times 10^{4})^{2}$",
          "guidance": null
        },
        {
          "tag": "5",
          "text": "$M = 2.0 \\times 10^{30}\\,\\text{kg}$",
          "guidance": null
        },
        {
          "tag": "6",
          "text": "or",
          "guidance": null
        },
        {
          "tag": "7",
          "text": "$GMm/r^{2} = mr\\omega^{2}$",
          "guidance": null
        },
        {
