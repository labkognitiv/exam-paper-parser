    {
      "id": "9702_s16_21_q06_c_ii",
      "label": "(c)(ii)",
      "marks": 2,
      "marking_points": [
        {
          "tag": "B1",
          "text": "$R = \\rho l/A$ or $R = 4\\rho l/\\pi d^{2}$",
          "guidance": null
        },
        {
          "tag": "A1",
          "text": "$R_{Y} = \\rho l/A$ and $R_{Z} = \\rho(2l)/4A$ so $R_{Y}/R_{Z} = 2$ or $R_{Y} = 4\\rho l/\\pi d^{2}$ and $R_{Z} = 4\\rho(2l)/\\pi 4d^{2}$ or $2\\rho l/\\pi d^{2}$ so $R_{Y}/R_{Z} = 2$",
          "guidance": null
        }
      ]
    },
    {
      "id": "9702_s16_21_q06_c_iii",
      "label": "(c)(iii)",
      "marks": 2,
      "marking_points": [
        {
          "tag": "C1",
          "text": "$V = 12R_{Y}/(R_{Y} + R_{Z})$ or $I = 12/(R_{Y} + R_{Z})$ and $V = IR_{Y}$",
          "guidance": null
        },
        {
          "tag": "A1",
          "text": "$V = 12 \\times 2/3$ $= 8(.0)\\text{ V}$",
          "guidance": null
