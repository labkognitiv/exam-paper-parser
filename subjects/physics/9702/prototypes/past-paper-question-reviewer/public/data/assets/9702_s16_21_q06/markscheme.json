      "marks": 3,
      "marking_points": [
        {
          "tag": "C1",
          "text": "ratio $= (I/nA_{Y}e)/(I/nA_{Z}e)$",
          "guidance": null
        },
        {
          "tag": "C1",
          "text": "$= A_{Z}/A_{Y}$ or $4A/A$ or $\\pi d^{2}/(\\pi d^{2}/4)$",
