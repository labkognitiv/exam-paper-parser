    {
      "part_id": "9709_w25_12_q1_a",
      "hints": [
        "Factor out $9$ from $9x^2 - 36x$.",
        "Complete the square on $x^2 - 4x$.",
        "Expand and combine constant terms."
      ],
      "walkthrough": [
        "Factorise the leading coefficient $9$ from the first two terms:\n$$9x^2 - 36x + 8 = 9(x^2 - 4x) + 8$$",
        "Complete the square inside the bracket:\n$$x^2 - 4x = (x - 2)^2 - 4$$",
        "Simplify into the required form:\n$$9(x - 2)^2 - 28$$"
      ]
    },
    {
      "part_id": "9709_w25_12_q1_b",
      "hints": [
        "The minimum value of $9(x-2)^2 - 28$ is $-28$.",
        "For no real roots, compare $k$ with this minimum value."
      ],
      "walkthrough": [
        "Use the completed-square form:\n$$9(x - 2)^2 - 28 = k$$",
        "Since $9(x - 2)^2 \\ge 0$, no real roots exist when $k + 28 < 0$."
      ]
    },
    {
      "part_id": "9709_w25_12_q1_c",
      "hints": [
        "Use $9(x-2)^2 - 28 = -15$ and isolate $(x-2)^2$.",
        "Take square roots and express $x$ in exact surd form."
      ],
      "walkthrough": [
        "Substitute the completed-square form:\n$$9(x - 2)^2 - 28 = -15$$",
        "Rearrange and take square roots:\n$$(x - 2)^2 = \\frac{13}{9}$$",
        "State both exact roots:\n$$x = 2 \\pm \\frac{\\sqrt{13}}{3}$$"
      ]
    }
  ]
