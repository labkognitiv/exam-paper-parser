        {
          "tag": "1",
          "text": "work done per unit charge (work done in) moving positive charge from infinity;",
          "guidance": null
        },
        {
          "tag": "2",
          "text": "$C = Q / V$",
          "guidance": null
        }
      ]
    },
    {
      "id": "9702_w21_42_q06_b",
      "label": "(b)",
      "marks": 2,
      "marking_points": [
        {
          "tag": "1",
          "text": "$V = Q / (4\\pi\\varepsilon_{0}r)$ and so $C = Q / [Q / (4\\pi\\varepsilon_{0}r)] = 4\\pi\\varepsilon_{0}r$;",
          "guidance": null
        },
        {
          "tag": "2",
          "text": "$Q = 4\\pi\\varepsilon_{0}rV = 4\\pi \\times 8.85 \\times 10^{-12} \\times 0.13 \\times 4500$ $(= 6.5 \\times 10^{-8} \\text{ C})$",
          "guidance": null
        }
      ]
    },
    {
      "id": "9702_w21_42_q06_c",
      "label": "(c)",
      "marks": 3,
      "marking_points": [
        {
          "tag": "1",
          "text": "$(Q - q) / 13 = q / 5.2$;",
          "guidance": null
        },
        {
          "tag": "2",
          "text": "$5.2Q - 5.2q = 13q$, so $q = (5.2 / 18.2)Q$;",
          "guidance": null
        },
        {
          "tag": "3",
          "text": "$q = (5.2 / 18.2) \\times 6.5 \\times 10^{-8}$ $= 1.9 \\times 10^{-8} \\text{ C}$;",
          "guidance": null
        },
        {
          "tag": "4",
          "text": "or;",
          "guidance": null
        },
        {
          "tag": "5",
          "text": "$V_{T} = Q_{T} / C_{T}$;",
          "guidance": null
        },
        {
          "tag": "6",
          "text": "$= 6.5 \\times 10^{-8} / [4\\pi \\times 8.85 \\times 10^{-12} \\times (0.13 + 0.052)]$ $(= 3210 \\text{ V})$;",
          "guidance": null
        },
        {
          "tag": "7",
          "text": "$q = 4\\pi \\times 8.85 \\times 10^{-12} \\times 0.052 \\times 3210$ $= 1.9 \\times 10^{-8} \\text{ C}$",
          "guidance": null
        }
      ]
    }
  ]
