      "marking_points": [
        {
          "tag": "1",
          "text": "gravitational force provides/is centripetal force",
          "guidance": null
        },
        {
          "tag": "2",
          "text": "GMm/r^2 = mv^2/r",
          "guidance": null
        },
        {
          "tag": "3",
          "text": "v = (2 x pi x 1.5 x 10^11)/(3600 x 24 x 365) = 2.99 x 10^4 (m s^-1)",
          "guidance": null
        },
        {
          "tag": "4",
          "text": "6.67 x 10^-11 M = 1.5 x 10^11 x (2.99 x 10^4)^2",
          "guidance": null
        },
        {
          "tag": "5",
          "text": "M = 2.0 x 10^30 kg",
          "guidance": null
        },
        {
          "tag": "6",
          "text": "or",
          "guidance": null
        },
        {
          "tag": "7",
          "text": "GMm/r^2 = mr omega^2",
          "guidance": null
        },
        {
          "tag": "8",
          "text": "omega = 2pi/(3600 x 24 x 365) = 1.99 x 10^-7 (rad s^-1)",
          "guidance": null
        },
        {
          "tag": "9",
          "text": "6.67 x 10^-11 M = (1.5 x 10^11)^3 x (1.99 x 10^-7)^2",
          "guidance": null
        },
        {
          "tag": "10",
          "text": "M = 2.0 x 10^30 kg",
          "guidance": null
        },
        {
          "tag": "11",
          "text": "or",
          "guidance": null
        },
        {
          "tag": "12",
          "text": "T^2 = 4pi^2 r^3 / GM",
          "guidance": null
        },
        {
          "tag": "13",
          "text": "M = 4pi^2 x (1.5 x 10^11)^3 / ((3600 x 24 x 365)^2 x 6.67 x 10^-11)",
          "guidance": null
