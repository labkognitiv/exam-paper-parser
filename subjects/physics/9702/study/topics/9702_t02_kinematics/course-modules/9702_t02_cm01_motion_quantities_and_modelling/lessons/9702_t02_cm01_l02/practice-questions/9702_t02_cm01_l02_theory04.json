  "marks": 2,
  "prompt": "A sprinter running at an initial velocity of 9.6 m s^-1 comes to rest with a constant deceleration of 3.2 m s^-2. Calculate the time taken for the sprinter to stop.",
  "mark_scheme": [
    {
      "mark": "C1",
      "criterion": "Rearranges a = (v - u) / t to t = (v - u) / a or substitutes 0 = 9.6 - 3.2t."
    },
    {
      "mark": "A1",
      "criterion": "t = 3.0 s"
    }
  ],
  "hints": [
    "Coming to rest means final velocity v = 0.",
    "Deceleration means acceleration is -3.2 m s^-2."
  ],
  "solution": "t = (v - u) / a = (0 - 9.6) / (-3.2) = 3.0 s.",
  "teacher_walkthrough": [
    "u = 9.6 m s^-1, v = 0, a = -3.2 m s^-2.",
    "Rearrange formula: t = (0 - 9.6) / (-3.2) = 9.6 / 3.2 = 3.0 s."
  ],
