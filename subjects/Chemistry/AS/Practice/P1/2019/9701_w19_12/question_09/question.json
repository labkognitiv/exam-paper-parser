{
  "stem": [
    {
      "type": "text",
      "text": "When lead(II) sulfide, $\\text{PbS}$, is heated in air, sulfur dioxide and lead(II) oxide are formed."
    },
    {
      "type": "text",
      "text": "What is the equation for the reaction between $\\text{PbS}$ and oxygen?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "equation",
        "latex": "\\text{PbS} + 2\\text{O}_2 \\rightarrow \\text{SO}_2 + \\text{PbO}_2"
      }
    ],
    "B": [
      {
        "type": "equation",
        "latex": "\\text{PbS} + 2\\dfrac{1}{2}\\text{O}_2 \\rightarrow \\text{SO}_3 + \\text{PbO}_2"
      }
    ],
    "C": [
      {
        "type": "equation",
        "latex": "\\text{PbS} + 1\\dfrac{1}{2}\\text{O}_2 \\rightarrow \\text{SO}_2 + \\text{PbO}"
      }
    ],
    "D": [
      {
        "type": "equation",
        "latex": "\\text{PbS} + 2\\text{O}_2 \\rightarrow \\text{SO}_3 + \\text{PbO}"
      }
    ]
  }
