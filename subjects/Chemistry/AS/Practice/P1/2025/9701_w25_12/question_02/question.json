  "layout": "list",
  "options": {
    "A": [
      {
        "type": "equation",
        "latex": "\\text{Br(g)} \\rightarrow \\text{Br}^{+}\\text{(g)} + \\text{e}^{-}"
      }
    ],
    "B": [
      {
        "type": "equation",
        "latex": "\\text{Br(g)} \\rightarrow \\text{Br}^{-}\\text{(g)} - \\text{e}^{-}"
      }
    ],
    "C": [
      {
        "type": "equation",
        "latex": "\\tfrac{1}{2}\\text{Br}_2\\text{(g)} \\rightarrow \\text{Br}^{+}\\text{(g)} + \\text{e}^{-}"
      }
    ],
    "D": [
      {
        "type": "equation",
        "latex": "\\tfrac{1}{2}\\text{Br}_2\\text{(g)} \\rightarrow \\text{Br}^{-}\\text{(g)} - \\text{e}^{-}"
