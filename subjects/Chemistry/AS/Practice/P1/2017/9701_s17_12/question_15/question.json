{
  "stem": [
    {
      "type": "text",
      "text": "Calcium oxide is added to water and the resulting mixture is filtered."
    },
    {
      "type": "text",
      "text": "This filtrate is X."
    },
    {
      "type": "text",
      "text": "When carbon dioxide is bubbled through filtrate X, a white precipitate is formed."
    },
    {
      "type": "text",
      "text": "Which equation for this reaction of filtrate X with carbon dioxide is correct?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "equation",
        "latex": "\\text{CaO} + \\text{CO}_2 \\rightarrow \\text{CaCO}_3"
      }
    ],
    "B": [
      {
        "type": "equation",
        "latex": "\\text{Ca(OH)}_2 + \\text{CO}_2 \\rightarrow \\text{CaO} + \\text{H}_2\\text{CO}_3"
      }
    ],
    "C": [
      {
        "type": "equation",
        "latex": "2\\text{CaO} + \\text{H}_2\\text{O} + \\text{CO}_2 \\rightarrow \\text{CaCO}_3 + \\text{Ca(OH)}_2"
      }
    ],
    "D": [
      {
        "type": "equation",
        "latex": "\\text{Ca(OH)}_2 + \\text{CO}_2 \\rightarrow \\text{CaCO}_3 + \\text{H}_2\\text{O}"
      }
    ]
  }
}
