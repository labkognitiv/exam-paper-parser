{
  "stem": [
    {
      "type": "text",
      "text": "In some fireworks there is a reaction between powdered aluminium and powdered barium nitrate. Heat is evolved, an unreactive gas is produced, and all nitrogen atoms are reduced."
    },
    {
      "type": "text",
      "text": "What is the equation for this reaction?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "equation",
        "latex": "2\\text{Al} + \\text{Ba(NO}_3\\text{)}_2 \\rightarrow \\text{Al}_2\\text{O}_3 + \\text{BaO} + 2\\text{NO}"
      }
    ],
    "B": [
      {
        "type": "equation",
        "latex": "4\\text{Al} + 4\\text{Ba(NO}_3\\text{)}_2 \\rightarrow 2\\text{Al}_2\\text{O}_3 + 4\\text{Ba(NO}_2\\text{)}_2 + \\text{O}_2"
      }
    ],
    "C": [
      {
        "type": "equation",
        "latex": "10\\text{Al} + 3\\text{Ba(NO}_3\\text{)}_2 \\rightarrow 5\\text{Al}_2\\text{O}_3 + 3\\text{BaO} + 3\\text{N}_2"
      }
    ],
    "D": [
      {
        "type": "equation",
        "latex": "10\\text{Al} + 18\\text{Ba(NO}_3\\text{)}_2 \\rightarrow 10\\text{Al(NO}_3\\text{)}_3 + 18\\text{BaO} + 3\\text{N}_2"
      }
    ]
  }
}
