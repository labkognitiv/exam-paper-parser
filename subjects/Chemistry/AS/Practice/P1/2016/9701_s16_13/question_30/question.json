{
  "stem": [
    {
      "type": "text",
      "text": "Caprolactone is a cyclic ester. It is being used increasingly for the manufacture of specialist polymers."
    },
    {
      "type": "figure",
      "id": "f1",
      "src": "q30_f1.svg",
      "kind": "skeletal",
      "alt": "Skeletal formula of caprolactone: a seven-membered lactone ring with a C=O group next to the ring oxygen.",
      "label": "caprolactone"
    },
    {
      "type": "text",
      "text": "From which compound could caprolactone be made by a single reaction?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$\\text{OHCCH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CHO}$"
