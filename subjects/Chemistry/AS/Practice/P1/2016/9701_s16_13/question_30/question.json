    ],
    "B": [
      {
        "type": "text",
        "text": "$\\text{HOCH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{OH}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$\\text{HOCH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CO}_2\\text{H}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$\\text{HO}_2\\text{CCH}_2\\text{CH}_2\\text{CH}_2\\text{CH}_2\\text{CO}_2\\text{H}$"
