{
  "stem": [
    {
      "type": "text",
      "text": "The general gas equation can be used to calculate the value of the $M_\\text{r}$ of a gas."
    },
    {
      "type": "text",
      "text": "For a sample of a gas of mass $m$ grams, which expression will give the value of $M_\\text{r}$?"
    }
  ],
  "layout": "list",
  "options": {
    "A": [
      {
        "type": "text",
        "text": "$M_\\text{r} = \\dfrac{mRT}{pV}$"
      }
    ],
    "B": [
      {
        "type": "text",
        "text": "$M_\\text{r} = \\dfrac{pVRT}{m}$"
      }
    ],
    "C": [
      {
        "type": "text",
        "text": "$M_\\text{r} = \\dfrac{mpV}{RT}$"
      }
    ],
    "D": [
      {
        "type": "text",
        "text": "$M_\\text{r} = \\dfrac{pV}{mRT}$"
      }
    ]
  }
}
