    {
      "type": "equation",
      "latex": "\\text{AgCl}\\text{(s)} \\rightleftharpoons \\text{Ag}^{+}\\text{(aq)} + \\text{Cl}^{-}\\text{(aq)} \\qquad K_\\text{c} = K_1"
