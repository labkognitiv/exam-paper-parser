            },
            {
              "criterion_id": "9709_p3_t_differential_equations_m03_l01_cpq06_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "Applies the chain rule $\\frac{\\mathrm{d}V}{\\mathrm{d}t} = \\frac{\\mathrm{d}V}{\\mathrm{d}h} \\frac{\\mathrm{d}h}{\\mathrm{d}t}$ and substitutes both expressions."
            },
            {
              "criterion_id": "9709_p3_t_differential_equations_m03_l01_cpq06_p01_mp04",
              "mark_type": "A1",
              "marks": 1,
              "text": "Cancels $\\pi$ and divides by $\\sqrt{h}$ to deduce $h^{\\frac{1}{2}} (20 - h) \\frac{\\mathrm{d}h}{\\mathrm{d}t} = -\\frac{2}{\\sqrt{10}}$, stating $A = \\frac{2}{\\sqrt{10}}$ (or $\\frac{\\sqrt{10}}{5}$)."
            }
          ]
        }
