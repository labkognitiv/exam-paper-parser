    {
      "question_id": "9709_s1_t_representation_of_data_m02_l04_cpq07",
      "parts": [
        {
          "part_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p01",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p01_c01",
              "mark": "M1",
              "text": "Calculate mean of coded variable y = x - 20 as 4.2 / 10 = 0.42 and hence mean of x = 20 + 0.42 = 20.42 mm."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p01_c02",
              "mark": "M1",
              "text": "Calculate variance of y: Var(y) = (3.68 / 10) - (0.42)^2 = 0.368 - 0.1764 = 0.1916 mm^2."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p01_c03",
              "mark": "A1",
              "text": "Calculate standard deviation of x = sqrt(0.1916) = 0.4377 mm (or 0.438 mm to 3 s.f.)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p02_c01",
              "mark": "B1",
              "text": "Calculate IQR = 20.7 - 20.1 = 0.6 mm and range = 21.8 - 19.4 = 2.4 mm."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p02_c02",
              "mark": "M1",
              "text": "Calculate fences: 1.5 * IQR = 0.9 mm, lower fence = 20.1 - 0.9 = 19.2 mm, upper fence = 20.7 + 0.9 = 21.6 mm."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p02_c03",
              "mark": "A1",
              "text": "Conclude that minimum 19.4 >= 19.2 is not an outlier, but maximum 21.8 > 21.6 is an outlier."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p03_c01",
              "mark": "B1",
              "text": "Explain that the competitor's data contains an outlier (21.8 mm), which distorts the mean and standard deviation."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p03_c02",
              "mark": "B1",
              "text": "Explain that the median and IQR are resistant measures that describe the true central location and middle 50% spread without being distorted by extreme values."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l04_cpq07_p03_c03",
              "mark": "B1",
              "text": "Compare consistency: the plant has standard deviation approximately 0.44 mm (equivalent to an estimated IQR of roughly 0.6 mm in symmetric normal data) whereas the competitor has an IQR of 0.6 mm, but the plant produces no extreme outliers, making the plant's production more reliably consistent."
            }
          ]
        }
      ]
    }
