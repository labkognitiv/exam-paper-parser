          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l02_cpq06_p02_c01",
              "mark": "M1",
              "text": "Set up linear interpolation for Q1: 100 + ((30 - 18) / 32) * 100."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l02_cpq06_p02_c02",
              "mark": "A1",
              "text": "Calculate Q1 = 100 + (12/32) * 100 = 137.5 hours."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m02_l02_cpq06_p02_c03",
              "mark": "A1",
              "text": "Set up and evaluate median: 200 + ((60 - 50) / 42) * 100 = 200 + 23.81 = 223.8 hours (or 224 hours to 3 s.f.)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m02_l02_cpq06_p03",
