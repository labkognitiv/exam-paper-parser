          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p01_c01",
              "mark": "B1",
              "text": "Recover frequencies: 5, 14 - 5 = 9, 26 - 14 = 12, 30 - 26 = 4."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p01_c02",
              "mark": "M1",
              "text": "Calculate sum(fx) = 5(10) + 9(25) + 12(40) + 4(65) = 50 + 225 + 480 + 260 = 1015."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p01_c03",
              "mark": "A1",
              "text": "Calculate estimated mean = 1015 / 30 = 33.833... = 33.8 minutes (3 s.f.)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p02_c01",
              "mark": "M1",
              "text": "Calculate sum(fx^2) = 5(100) + 9(625) + 12(1600) + 4(4225) = 500 + 5625 + 19200 + 16900 = 42225."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p02_c02",
              "mark": "M1",
              "text": "Calculate estimated variance = (42225 / 30) - (1015 / 30)^2 = 1407.5 - 1144.694... = 262.8055..."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq05_p02_c03",
              "mark": "A1",
              "text": "Calculate estimated standard deviation = sqrt(262.8055...) = 16.211... = 16.2 minutes (3 s.f.)."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_representation_of_data_m03_l02_cpq06",
      "parts": [
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p01_c01",
              "mark": "M1",
              "text": "Calculate totals: sum(x1) = 12 * 20 = 240 and sum(x2) = 8 * 25 = 200, giving combined sum 440."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p01_c02",
              "mark": "A1",
              "text": "Divide by 20 to obtain combined mean = 440 / 20 = 22."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p02_c01",
              "mark": "M1",
              "text": "For Group 1: Var1 = 3^2 = 9; sum(x1^2) = 12 * (9 + 20^2) = 12 * (9 + 400) = 12 * 409 = 4908."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p02_c02",
              "mark": "M1",
              "text": "For Group 2: Var2 = 4^2 = 16; sum(x2^2) = 8 * (16 + 25^2) = 8 * (16 + 625) = 8 * 641 = 5128."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p02_c03",
              "mark": "A1",
              "text": "Sum the sums of squares: sum(x_comb^2) = 4908 + 5128 = 10036."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p03_c01",
              "mark": "M1",
              "text": "Set up combined variance: (10036 / 20) - 22^2."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p03_c02",
              "mark": "A1",
              "text": "Calculate combined variance = 501.8 - 484 = 17.8."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq06_p03_c03",
              "mark": "A1",
              "text": "Calculate combined standard deviation = sqrt(17.8) = 4.219... = 4.22 (3 s.f.)."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_representation_of_data_m03_l02_cpq07",
      "parts": [
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p01",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p01_c01",
              "mark": "M1",
              "text": "Let y = x - 50; calculate mean of y = 15.0 / 25 = 0.6 mm, so mean of x = 50 + 0.6 = 50.6 mm."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p01_c02",
              "mark": "M1",
              "text": "Calculate variance: Var(x) = Var(y) = (41.25 / 25) - (0.6)^2 = 1.65 - 0.36 = 1.29 mm^2."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p01_c03",
              "mark": "A1",
              "text": "Calculate standard deviation = sqrt(1.29) = 1.1357... = 1.14 mm (3 s.f.)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p02_c01",
              "mark": "M1",
              "text": "Calculate totals: sum(xA) = 25 * 50.6 = 1265 and sum(xB) = 15 * 50.2 = 753, giving combined sum 2018."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p02_c02",
              "mark": "A1",
              "text": "Calculate combined mean = 2018 / 40 = 50.45 mm."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p02_c03",
              "mark": "A1",
              "text": "Calculate sum(xA^2) = 25 * (1.29 + 50.6^2) = 64036.25 and sum(xB^2) = 15 * (0.80^2 + 50.2^2) = 37810.2, giving combined sum of squares = 101846.45."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p03_c01",
              "mark": "B1",
              "text": "Compare central tendency: Machine B is closer to the nominal target of 50.0 mm (mean 50.2 mm vs 50.6 mm)."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p03_c02",
              "mark": "B1",
              "text": "Compare consistency: Machine B is more consistent because its standard deviation is smaller (0.80 mm < 1.14 mm)."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l02_cpq07_p03_c03",
              "mark": "B1",
              "text": "Explain combined spread: the combined standard deviation increases because of both the higher internal variance of Machine A and the difference between the two group means (50.6 vs 50.2), which adds between-group variation."
            }
          ]
        }
      ]
    }
  ]
