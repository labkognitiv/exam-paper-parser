            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq02_p02_c01",
              "mark": "M1",
              "text": "Calculate products fx: 4(5) = 20, 7(15) = 105, 5(25) = 125, 4(40) = 160."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq02_p02_c02",
              "mark": "A1",
              "text": "Sum products: sum(fx) = 20 + 105 + 125 + 160 = 410."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq02_p02_c03",
              "mark": "A1",
              "text": "Calculate estimated mean = 410 / 20 = 20.5 minutes."
            }
          ]
        }
