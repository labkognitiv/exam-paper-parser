        },
        {
          "part_id": "9709_s1_t_representation_of_data_m03_l01_cpq06_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq06_p02_c01",
              "mark": "B1",
              "text": "Calculate combined mean = 6860 / 100 = 68.6."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq06_p02_c02",
              "mark": "B1",
              "text": "Calculate unweighted mean: (64.0 + 72.0 + 68.5) / 3 = 68.167 (or 68.2)."
            },
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq06_p02_c03",
              "mark": "B1",
              "text": "Explain that the classes have unequal sizes (25, 35, 40), so larger classes must have proportionally greater weighting in the overall mean."
            }
          ]
        },
