          "marking_points": [
            {
              "criterion_id": "9709_s1_t_representation_of_data_m03_l01_cpq01_p01_c01",
              "mark": "M1",
              "text": "Calculate totals for both squads: 9 * 168 = 1512 cm and 11 * 174 = 1914 cm."
