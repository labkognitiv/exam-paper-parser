{
  "lesson_id": "9709_s1_t_discrete_random_variables_m02_l02",
  "questions": [
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq01",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq01_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq01_p01_c1",
              "type": "M1",
              "text": "Substitutes squared outcomes into the expectation formula $E(X^2) = 1^2(0.2) + 2^2(0.5) + 4^2(0.3)$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq01_p01_c2",
              "type": "A1",
              "text": "Obtains $E(X^2) = 7$ and calculates $\\text{Var}(X) = 7 - 2.4^2 = 1.24$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq02",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq02_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq02_p01_c1",
              "type": "B1",
              "text": "Finds mean $E(X) = -2(0.3) + 1(0.4) + 4(0.3) = 1$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq02_p01_c2",
              "type": "A1",
              "text": "Evaluates $E(X^2) = (-2)^2(0.3) + 1^2(0.4) + 4^2(0.3) = 6.4$ and shows $\\text{Var}(X) = 6.4 - 1^2 = 5.4$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq03",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq03_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq03_p01_c1",
              "type": "M1",
              "text": "Calculates $E(X^2) = 1^2\\left(\\frac{1}{14}\\right) + 2^2\\left(\\frac{4}{14}\\right) + 3^2\\left(\\frac{9}{14}\\right) = \\frac{1 + 16 + 81}{14} = 7$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq03_p01_c2",
              "type": "A1",
              "text": "Obtains exact variance $\\text{Var}(X) = 7 - \\left(\\frac{18}{7}\\right)^2 = 7 - \\frac{324}{49} = \\frac{19}{49}$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq04",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq04_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq04_p01_c1",
              "type": "M1",
              "text": "Calculates variance $\\text{Var}(X) = 7.4 - (2.2)^2 = 7.4 - 4.84 = 2.56$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq04_p01_c2",
              "type": "A1",
              "text": "Takes the positive square root to obtain standard deviation $\\sigma = \\sqrt{2.56} = 1.6$ (or $1.60$ to 3 s.f.)."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq05",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq05_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq05_p01_c1",
              "type": "B1",
              "text": "Finds expectation $E(X) = 1\\left(\\frac{2}{4}\\right) + 2\\left(\\frac{1}{4}\\right) + 4\\left(\\frac{1}{4}\\right) = \\frac{8}{4} = 2$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq05_p01_c2",
              "type": "A1",
              "text": "Calculates $E(X^2) = 1^2\\left(\\frac{2}{4}\\right) + 2^2\\left(\\frac{1}{4}\\right) + 4^2\\left(\\frac{1}{4}\\right) = \\frac{22}{4} = 5.5$ and obtains $\\text{Var}(X) = 5.5 - 2^2 = 1.5$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_drq06",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_drq06_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq06_p01_c1",
              "type": "M1",
              "text": "Computes $E(X^2) = \\frac{1^2 + 2^2 + 3^2 + 4^2 + 5^2 + 6^2}{6} = \\frac{1 + 4 + 9 + 16 + 25 + 36}{6} = \\frac{91}{6}$."
            },
            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_drq06_p01_c2",
              "type": "A1",
              "text": "Calculates $\\text{Var}(X) = \\frac{91}{6} - \\left(\\frac{7}{2}\\right)^2 = \\frac{91}{6} - \\frac{49}{4} = \\frac{182 - 147}{12} = \\frac{35}{12}$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_discrete_random_variables_m02_l02_cpq01",
      "parts": [
        {
          "part_id": "9709_s1_t_discrete_random_variables_m02_l02_cpq01_p01",
          "marks": 2,
