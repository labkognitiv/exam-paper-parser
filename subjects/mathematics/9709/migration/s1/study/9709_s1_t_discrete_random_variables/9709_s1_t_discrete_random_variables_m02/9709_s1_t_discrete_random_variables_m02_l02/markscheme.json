            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_cpq05_p02_c1",
              "type": "M1",
              "text": "Sets up second moment $E(Y^2) = (-1)^2(0.4) + 5^2(0.3) + 15^2(0.2) + 29^2(0.1)$."
