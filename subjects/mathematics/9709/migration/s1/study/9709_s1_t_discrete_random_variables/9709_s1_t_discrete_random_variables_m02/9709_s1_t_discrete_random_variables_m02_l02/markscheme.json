            {
              "criterion_id": "9709_s1_t_discrete_random_variables_m02_l02_cpq01_p02_c2",
              "type": "A1",
              "text": "Evaluates standard deviation $\\sigma = \\sqrt{1.25} = 1.12$ (to 3 s.f.)."
