            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_probability_m03_l04_cpq01",
      "parts": [
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq01_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq01_p01_c1",
              "type": "M1",
              "text": "Sets up total probability equation: $0.65 \\times 0.90 + 0.35p = 0.83$."
