            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq01_p01_c2",
              "type": "A1",
              "text": "Solves $0.585 + 0.35p = 0.83 \\implies 0.35p = 0.245$ to obtain $p = 0.70$ (or $\\frac{7}{10}$)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq01_p02",
