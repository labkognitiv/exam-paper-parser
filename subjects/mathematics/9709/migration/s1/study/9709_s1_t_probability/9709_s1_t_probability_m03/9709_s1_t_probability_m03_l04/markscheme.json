          ]
        },
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq06_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p02_c1",
              "type": "M1",
              "text": "Identifies that $S = 3$ corresponds to $(1, 2)$ and $(2, 1)$, giving $2pq = 0.24$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p02_c2",
              "type": "A1",
              "text": "Substitutes $p = 0.40$ to get $2(0.40)q = 0.24 \\implies 0.80q = 0.24 \\implies q = 0.30$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p02_c3",
              "type": "A1",
              "text": "Uses $p + q + r = 1$ to find $r = 1 - 0.40 - 0.30 = 0.30$."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq06_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p03_c1",
              "type": "M1",
              "text": "Finds $P(S \\ge 5) = P(S = 5) + P(S = 6) = 2qr + r^2 = 2(0.3)(0.3) + 0.3^2 = 0.18 + 0.09 = 0.27$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p03_c2",
              "type": "M1",
              "text": "Identifies that among outcomes with $S \\ge 5$, only $(2, 3)$ and $(3, 2)$ contain a 2, with joint probability $0.18$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq06_p03_c3",
              "type": "A1",
              "text": "Forms conditional ratio $\\frac{0.18}{0.27} = \\frac{2}{3}$ (or $0.667$ to 3 s.f.)."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_probability_m03_l04_cpq07",
      "parts": [
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq07_p01",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p01_c1",
              "type": "M1",
              "text": "Expresses the probability of drawing two blue counters without replacement as $\\frac{n}{n + 3} \\times \\frac{n - 1}{n + 2} = \\frac{n(n - 1)}{(n + 3)(n + 2)}$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p01_c2",
              "type": "M1",
              "text": "Equates to $\\frac{5}{12}$ and cross-multiplies: $12(n^2 - n) = 5(n^2 + 5n + 6) \\implies 12n^2 - 12n = 5n^2 + 25n + 30$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p01_c3",
              "type": "A1",
              "text": "Derives $7n^2 - 37n - 30 = 0$ and factorises $(7n + 5)(n - 6) = 0$ to deduce $n = 6$ (rejecting $n = -\\frac{5}{7}$)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq07_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p02_c1",
              "type": "M1",
              "text": "Identifies the three mutually exclusive arrangements for exactly two blue counters in three draws: $BBR, BRB, RBB$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p02_c2",
              "type": "M1",
              "text": "Calculates branch probabilities from $3$ red and $6$ blue counters (total $9$): each arrangement has probability $\\frac{6}{9} \\times \\frac{5}{8} \\times \\frac{3}{7} = \\frac{90}{504} = \\frac{5}{28}$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p02_c3",
              "type": "A1",
              "text": "Multiplies by 3 to obtain $3 \\times \\frac{5}{28} = \\frac{15}{28}$ (or $0.536$ to 3 s.f.)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_probability_m03_l04_cpq07_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p03_c1",
              "type": "B1",
              "text": "Identifies that only the arrangement $RBB$ has the first counter red, with probability $\\frac{5}{28}$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p03_c2",
              "type": "M1",
              "text": "Forms conditional ratio with denominator from part (b): $\\frac{5/28}{15/28}$."
            },
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_cpq07_p03_c3",
              "type": "A1",
              "text": "Simplifies to $\\frac{5}{15} = \\frac{1}{3}$ (or $0.333$ to 3 s.f.)."
            }
          ]
        }
      ]
    }
  ]
