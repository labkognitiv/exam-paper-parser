          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_probability_m03_l04_drq06_p01_c1",
              "type": "M1",
              "text": "Uses sum of probabilities $p + 2p + 3p + 4p = 10p = 1$ to find $p = 0.1$."
