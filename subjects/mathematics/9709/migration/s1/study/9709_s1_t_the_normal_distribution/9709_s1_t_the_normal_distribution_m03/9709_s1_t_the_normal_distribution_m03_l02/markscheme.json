    {
      "question_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06",
      "parts": [
        {
          "part_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p01",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p01_c01",
              "mark": "M1",
              "text": "Calculate probabilities of exactly 2 ones (3*(1/4)^2*(3/4) = 9/64) and exactly 3 ones ((1/4)^3 = 1/64)."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p01_c02",
              "mark": "A1",
              "text": "Sum the two probabilities: 9/64 + 1/64 = 10/64 = 5/32."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p02",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p02_c01",
              "mark": "M1",
              "text": "Evaluate np = 128 * (5/32) = 20 and nq = 128 * (27/32) = 108."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p02_c02",
              "mark": "A1",
              "text": "State that both np = 20 > 5 and nq = 108 > 5, confirming the normal approximation is valid."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p02_c03",
              "mark": "B1",
              "text": "Calculate variance sigma^2 = 128 * (5/32) * (27/32) = 16.875 and state Y ~ N(20, 16.875)."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p03",
          "marks": 3,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p03_c01",
              "mark": "B1",
              "text": "Apply continuity correction to rewrite P(X < 15) as P(Y < 14.5)."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p03_c02",
              "mark": "M1",
              "text": "Standardise Y = 14.5 with (14.5 - 20)/sqrt(16.875) to find z = -1.339."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m03_l02_cpq06_p03_c03",
              "mark": "A1",
              "text": "Evaluate Phi(-1.339) = 1 - Phi(1.339) = 1 - 0.9097 = 0.0903."
            }
          ]
        }
      ]
