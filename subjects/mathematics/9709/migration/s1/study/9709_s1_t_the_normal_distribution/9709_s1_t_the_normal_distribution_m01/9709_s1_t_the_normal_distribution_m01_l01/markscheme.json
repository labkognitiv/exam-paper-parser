          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq02_p02_c01",
              "mark": "M1",
              "text": "Calculate the interval probability P(165 < X < 180) = P(X < 180) - P(X < 165) = 0.5 - 0.1587."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq02_p02_c02",
              "mark": "A1",
              "text": "Obtain the interval probability 0.3413."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq02_p02_c03",
              "mark": "A1",
              "text": "Multiply by 600 to obtain an expected number of 204.78 (or 205 sunflowers)."
            }
          ]
        }
      ]
    },
    {
