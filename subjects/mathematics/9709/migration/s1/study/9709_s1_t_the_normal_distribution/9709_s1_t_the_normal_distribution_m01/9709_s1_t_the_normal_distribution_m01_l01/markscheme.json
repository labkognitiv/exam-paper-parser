            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_drq05_p01_c02",
              "mark": "A1",
              "text": "Look up Phi(1.25) = 0.8944 to obtain 1 - 0.8944 = 0.1056."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_the_normal_distribution_m01_l01_drq06",
