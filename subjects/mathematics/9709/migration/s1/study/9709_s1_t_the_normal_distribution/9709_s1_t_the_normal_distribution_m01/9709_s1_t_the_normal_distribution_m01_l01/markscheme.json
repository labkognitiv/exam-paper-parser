      "parts": [
        {
          "part_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq02_p01",
          "label": "a",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq02_p01_c01",
              "mark": "M1",
              "text": "Standardise z = (165 - 180) / 15 = -1.0 and use symmetry to write 1 - Phi(1.0)."
