          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01",
      "parts": [
        {
          "part_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p01",
          "label": "a",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p01_c01",
              "mark": "M1",
              "text": "Standardise with z = (166 - 150) / 16 = 1.0."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p01_c02",
              "mark": "A1",
              "text": "Look up Phi(1.0) = 0.8413 to obtain P(X < 166) = 0.8413."
            }
          ]
        },
        {
          "part_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p02",
          "label": "b",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p02_c01",
              "mark": "M1",
              "text": "Apply the complement rule P(X > 166) = 1 - P(X < 166) = 1 - 0.8413."
            },
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_cpq01_p02_c02",
              "mark": "A1",
              "text": "Evaluate the difference to obtain 0.1587."
            }
          ]
        }
      ]
    },
    {
