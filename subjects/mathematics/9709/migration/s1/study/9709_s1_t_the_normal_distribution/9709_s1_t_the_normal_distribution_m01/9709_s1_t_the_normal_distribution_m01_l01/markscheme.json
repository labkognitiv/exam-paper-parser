            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_drq04_p01_c02",
              "mark": "A1",
              "text": "Look up Phi(0.8) = 0.7881 to obtain 1 - 0.7881 = 0.2119."
