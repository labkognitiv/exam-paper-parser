          ]
        }
      ]
    },
    {
      "question_id": "9709_s1_t_the_normal_distribution_m01_l01_drq05",
      "parts": [
        {
          "part_id": "9709_s1_t_the_normal_distribution_m01_l01_drq05_p01",
          "label": "a",
          "marks": 2,
          "marking_points": [
            {
              "criterion_id": "9709_s1_t_the_normal_distribution_m01_l01_drq05_p01_c01",
              "mark": "M1",
              "text": "Apply the symmetry property of the normal distribution to write P(Z < -1.25) = 1 - Phi(1.25)."
