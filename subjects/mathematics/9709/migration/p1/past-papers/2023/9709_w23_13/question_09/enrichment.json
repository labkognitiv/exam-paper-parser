      "hints": [
        "Differentiate $y = 2x^{1/2} - 1$ to find $\\frac{dy}{dx} = x^{-1/2}$.",
        "Evaluate the tangent gradient at $x = 4$: $m_T = 4^{-1/2} = \\frac{1}{2}$.",
        "Find the normal gradient $m_N = -\\frac{1}{1/2} = -2$.",
        "Write the equation of the normal passing through $A(4, 3)$ in the form $y = mx + c$."
      ],
      "walkthrough": [
        "Differentiate $y = 2x^{1/2} - 1$ with respect to $x$:\n$$\\frac{dy}{dx} = 2\\left(\\frac{1}{2}x^{-1/2}\\right) = x^{-1/2} = \\frac{1}{\\sqrt{x}}$$",
        "Evaluate the gradient of the tangent at point $A(4, 3)$:\n$$m_T = \\left.\\frac{dy}{dx}\\right|_{x=4} = \\frac{1}{\\sqrt{4}} = \\frac{1}{2}$$",
        "Calculate the gradient of the normal line:\n$$m_N = -\\frac{1}{m_T} = -\\frac{1}{1/2} = -2$$",
        "Write the equation of the normal line through $A(4, 3)$ in $y = mx + c$ form:\n$$y - 3 = -2(x - 4) \\implies y - 3 = -2x + 8 \\implies y = -2x + 11$$"
      ],
      "checking": {
        "mode": "ai",
        "ai_rubric": {
          "Tangents and Normals": "Finds $\\frac{dy}{dx} = x^{-1/2} = \\frac{1}{2}$ at $x=4$, normal gradient $-2$, and gives normal equation $y = -2x + 11$."
        },
        "criteria_source": "mark_scheme_structured"
