      "hints": [
        "Differentiate $y = 4x^{1/2} - x$ with respect to $x$.",
        "Set the derivative equal to $0$ and solve for $\\sqrt{x}$."
      ],
      "walkthrough": [
        "Differentiate $y = 4x^{1/2} - x$ with respect to $x$:\n$$\\frac{dy}{dx} = 4\\left(\\frac{1}{2}\\right)x^{-1/2} - 1 = 2x^{-1/2} - 1 = \\frac{2}{\\sqrt{x}} - 1$$",
        "Set $\\frac{dy}{dx} = 0$ to locate the stationary maximum:\n$$\\frac{2}{\\sqrt{x}} - 1 = 0 \\implies \\sqrt{x} = 2$$",
        "Solve for $a$:\n$$a = 2^2 = 4$$"
      ],
      "checking": {
