        "ai_rubric": {
          "Trigonometric Identities": "Expands squared terms (B1). Uses $\\sin^2 x + \\cos^2 x = 1$ (M1). Shows $a^2 + b^2 = \\frac{1}{2}$ (A1)."
        },
