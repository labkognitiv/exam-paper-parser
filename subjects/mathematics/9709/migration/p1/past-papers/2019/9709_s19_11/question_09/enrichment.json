      "hints": [
        "For $f(x) = 2 - 3\\cos x$, evaluate minimum $2 - 3(1) = -1$ and maximum $2 - 3(-1) = 5$."
      ],
      "walkthrough": [
        "Determine the range of $f(x) = 2 - 3\\cos x$ on $0 \\le x \\le 2\\pi$ (where $-1 \\le \\cos x \\le 1$):\n$$\\text{Minimum value} = 2 - 3(1) = -1$$\n$$\\text{Maximum value} = 2 - 3(-1) = 5$$\n$$\\text{Range of } f: \\quad -1 \\le f(x) \\le 5 \\quad (\\text{or } [-1, 5])$$"
      ],
      "checking": {
        "mode": "ai",
