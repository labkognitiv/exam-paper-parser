        "ai_rubric": {
          "Trigonometric Identities": "Reaches $\\frac{\\cos^2\\theta - \\sin^2\\theta}{\\cos^2\\theta}$ (M1). Completes proof to show $1 - \\tan^2\\theta$ (A1)."
        },
