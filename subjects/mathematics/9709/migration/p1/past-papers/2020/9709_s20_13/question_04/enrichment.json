      "hints": [
        "Apply the binomial expansion $\\binom{5}{r}a^r$ for $(1 + a)^5$."
      ],
      "walkthrough": [
        "Expand $(1 + a)^5$ in ascending powers of $a$ up to $a^3$:\n$$(1 + a)^5 = 1 + \\binom{5}{1}a + \\binom{5}{2}a^2 + \\binom{5}{3}a^3 + \\dots = 1 + 5a + 10a^2 + 10a^3$$"
      ],
      "checking": {
