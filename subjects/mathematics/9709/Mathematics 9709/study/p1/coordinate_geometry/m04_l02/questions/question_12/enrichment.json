      "hints": [
        "In $(x-a)^2+(y-b)^2=r^2$, the centre is $(a,b)$.",
        "Set each factor equal to zero.",
        "Substitute each $x$-value into $y=x+2$."
      ],
      "walkthrough": [
        "The centre is $(2,3)$ and $r=5$.",
        "$(x-5)(x+2)=0$ gives $x=5$ or $x=-2$.",
        "The matching $y$-values are $7$ and $0$, so the points are $(5,7)$ and $(-2,0)$."
      ]
    },
