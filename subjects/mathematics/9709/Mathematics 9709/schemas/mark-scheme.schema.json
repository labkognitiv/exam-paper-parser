{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kognitiv.local/schemas/9709-mathematics-mark-scheme-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "question_num",
    "subject_code",
    "component",
    "total_marks",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": "9709_math_mark_scheme_v2"
    },
    "paper_code": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "question_num": {
      "type": "integer",
      "minimum": 1
    },
    "subject_code": {
      "const": "9709"
    },
    "component": {
      "enum": [
        "P1",
        "P3",
        "M1",
        "S1"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 2016,
      "maximum": 2025
    },
    "session": {
      "enum": [
        "Feb/March",
        "May/June",
        "Oct/Nov"
      ]
    },
    "variant": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^9709_(p1|p3|m1|s1)_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}$",
      "description": "Lesson practice question: the owning study lesson (replaces the paper fields)."
    },
    "topic_id": {
      "type": "string",
      "pattern": "^9709_(p1|p3|m1|s1)_t_[a-z0-9_]+$"
    },
    "total_marks": {
      "type": "integer",
      "minimum": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "finalised_csv",
            "official_pdf"
          ]
        },
        "csv": {
          "type": "string"
        },
        "csv_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdf": {
          "type": "string",
          "pattern": "^source/9709_[msw][0-9]{2}_ms_[0-9]{2}\\.pdf$"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "finalised_csv"
            }
          },
          "required": [
            "kind",
            "csv",
            "csv_sha256"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "official_pdf"
            }
          },
          "required": [
            "kind",
            "pdf",
            "pdf_sha256"
          ]
        }
      ]
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "marks",
        "answer",
        "official_mark_scheme_text",
        "structured",
        "criteria",
        "alternative_routes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "marks": {
          "type": "integer",
          "minimum": 1
        },
        "answer": {
          "type": "string"
        },
        "accepted_alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Lesson practice only: other final-answer forms to accept."
        },
        "tolerance": {
          "type": "string",
          "minLength": 1,
          "description": "Lesson practice only: required exactness or accuracy of the final answer."
        },
        "official_mark_scheme_text": {
          "type": "string",
          "minLength": 1
        },
        "structured": {
          "type": "object",
          "required": [
            "version",
            "sections",
            "total"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "source_section",
              "working",
              "mark",
              "guidance",
              "observable",
              "observable_status"
            ],
            "properties": {
              "criterion_id": {
                "type": "string"
              },
              "source_section": {
                "type": "string"
              },
              "working": {
                "type": "string"
              },
              "mark": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "observable": {
                "type": "string"
              },
              "observable_status": {
                "const": "source-preserved"
              }
            }
          }
        },
        "alternative_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route_id",
              "label",
              "criterion_ids"
            ],
            "properties": {
              "route_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "criterion_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "title": "Cambridge Mathematics 9709 shared mark scheme (past paper or lesson practice)",
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "paper_code",
            "year",
            "session",
            "variant",
            "source"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "lesson_id"
                ]
              },
              {
                "required": [
                  "topic_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "lesson_id",
            "topic_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "paper_code"
                ]
              },
              {
                "required": [
                  "year"
                ]
              },
              {
                "required": [
                  "session"
                ]
              },
              {
                "required": [
                  "variant"
                ]
              },
              {
                "required": [
                  "source"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(11|12|13)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(11|12|13)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(11|12|13)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P3"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(31|32|33)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(31|32|33)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(31|32|33)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "M1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(41|42|43)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(41|42|43)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(41|42|43)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "S1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(51|52|53|61|62|63)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(51|52|53|61|62|63)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(51|52|53|61|62|63)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_p1_t_"
          },
          "topic_id": {
            "pattern": "^9709_p1_t_"
          },
          "question_id": {
            "pattern": "^9709_p1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P3"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_p3_t_"
          },
          "topic_id": {
            "pattern": "^9709_p3_t_"
          },
          "question_id": {
            "pattern": "^9709_p3_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "M1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_m1_t_"
          },
          "topic_id": {
            "pattern": "^9709_m1_t_"
          },
          "question_id": {
            "pattern": "^9709_m1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "S1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_s1_t_"
          },
          "topic_id": {
            "pattern": "^9709_s1_t_"
          },
          "question_id": {
            "pattern": "^9709_s1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    }
  ]
}
