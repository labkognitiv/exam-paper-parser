{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kognitiv.local/schemas/9709-mathematics-question-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "question_num",
    "subject_code",
    "component",
    "question_stem",
    "context_texts",
    "total_marks",
    "figures",
    "parts",
    "content_flow",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "9709_math_question_v2"
    },
    "paper_code": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "question_num": {
      "type": "integer",
      "minimum": 1
    },
    "subject_code": {
      "const": "9709"
    },
    "component": {
      "enum": [
        "P1",
        "P3",
        "M1",
        "S1"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 2016,
      "maximum": 2025
    },
    "session": {
      "enum": [
        "Feb/March",
        "May/June",
        "Oct/Nov"
      ]
    },
    "variant": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^9709_(p1|p3|m1|s1)_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}$",
      "description": "Lesson practice question: the owning study lesson (replaces the paper fields)."
    },
    "topic_id": {
      "type": "string",
      "pattern": "^9709_(p1|p3|m1|s1)_t_[a-z0-9_]+$"
    },
    "question_stem": {
      "type": "string"
    },
    "context_texts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "total_marks": {
      "type": "integer",
      "minimum": 1
    },
    "figures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "content_flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "part_id"
        ],
        "properties": {
          "type": {
            "const": "part"
          },
          "part_id": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_structure_checked",
        "marks_reconciled",
        "numerical_values_checked"
      ],
      "properties": {
        "content_structure_checked": {
          "const": true
        },
        "marks_reconciled": {
          "const": true
        },
        "numerical_values_checked": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "file",
        "sha256",
        "referenced_by",
        "placement"
      ],
      "properties": {
        "figure_id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "referenced_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "placement": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "part_id",
                "position"
              ],
              "properties": {
                "scope": {
                  "const": "part"
                },
                "part_id": {
                  "type": "string"
                },
                "position": {
                  "enum": [
                    "before_part",
                    "after_part"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "position"
              ],
              "properties": {
                "scope": {
                  "const": "question"
                },
                "position": {
                  "enum": [
                    "before_stem",
                    "after_stem"
                  ]
                }
              }
            }
          ]
        },
        "display": {
          "type": "boolean",
          "default": true,
          "description": "False preserves source-only figures omitted from the reviewed presentation. Keep asset, references and source placement; do not render."
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "label",
        "parent_id",
        "display_order",
        "question_text",
        "marks",
        "answer_type",
        "figure_ids",
        "response_schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_order": {
          "type": "integer",
          "minimum": 1
        },
        "question_text": {
          "type": "string",
          "minLength": 1
        },
        "part_stem": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "integer",
          "minimum": 1
        },
        "answer_type": {
          "enum": [
            "drawing",
            "extended-text",
            "math-with-working"
          ]
        },
        "figure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "part_id"
            ],
            "properties": {
              "type": {
                "const": "question_context"
              },
              "part_id": {
                "type": "string"
              }
            }
          }
        },
        "response_schema": {
          "type": "object",
          "required": [
            "version",
            "blocks"
          ],
          "properties": {
            "version": {
              "const": "0.1"
            },
            "blocks": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "title": "Cambridge Mathematics 9709 shared question (past paper or lesson practice)",
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "paper_code",
            "year",
            "session",
            "variant"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "lesson_id"
                ]
              },
              {
                "required": [
                  "topic_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "lesson_id",
            "topic_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "paper_code"
                ]
              },
              {
                "required": [
                  "year"
                ]
              },
              {
                "required": [
                  "session"
                ]
              },
              {
                "required": [
                  "variant"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(11|12|13)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(11|12|13)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(11|12|13)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P3"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(31|32|33)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(31|32|33)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(31|32|33)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "M1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(41|42|43)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(41|42|43)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(41|42|43)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "S1"
          }
        },
        "required": [
          "component",
          "paper_code"
        ]
      },
      "then": {
        "properties": {
          "paper_code": {
            "pattern": "^9709_[msw][0-9]{2}_(51|52|53|61|62|63)$"
          },
          "question_id": {
            "pattern": "^9709_[msw][0-9]{2}_(51|52|53|61|62|63)_q[0-9]+(?:_[a-z0-9]+)*$"
          },
          "variant": {
            "pattern": "^(51|52|53|61|62|63)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_p1_t_"
          },
          "topic_id": {
            "pattern": "^9709_p1_t_"
          },
          "question_id": {
            "pattern": "^9709_p1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "P3"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_p3_t_"
          },
          "topic_id": {
            "pattern": "^9709_p3_t_"
          },
          "question_id": {
            "pattern": "^9709_p3_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "M1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_m1_t_"
          },
          "topic_id": {
            "pattern": "^9709_m1_t_"
          },
          "question_id": {
            "pattern": "^9709_m1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "S1"
          }
        },
        "required": [
          "component",
          "lesson_id"
        ]
      },
      "then": {
        "properties": {
          "lesson_id": {
            "pattern": "^9709_s1_t_"
          },
          "topic_id": {
            "pattern": "^9709_s1_t_"
          },
          "question_id": {
            "pattern": "^9709_s1_t_[a-z0-9_]+_m[0-9]{2}_l[0-9]{2}_[a-z0-9_]+$"
          }
        }
      }
    }
  ]
}
