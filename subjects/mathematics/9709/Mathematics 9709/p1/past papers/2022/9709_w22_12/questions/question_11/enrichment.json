      "hints": [
        "Differentiate to find $\\frac{dy}{dx} = -\\frac{15}{16}x^{3/2}$.",
        "Evaluate at $x = 4$ to get $\\frac{dy}{dx} = -7.5$.",
        "Multiply by $\\frac{dx}{dt} = 2$."
      ],
      "walkthrough": [
        "Differentiate $y = 18 - \\frac{3}{8}x^{5/2}$ with respect to $x$:\n$$\\frac{dy}{dx} = -\\frac{3}{8} \\times \\frac{5}{2}x^{3/2} = -\\frac{15}{16}x^{3/2}$$",
        "Evaluate $\\frac{dy}{dx}$ at $x = 4$:\n$$\\left.\\frac{dy}{dx}\\right|_{x=4} = -\\frac{15}{16}(4^{3/2}) = -\\frac{15}{16}(8) = -\\frac{15}{2}$$",
        "Apply the chain rule $\\frac{dy}{dt} = \\frac{dy}{dx} \\times \\frac{dx}{dt}$ with $\\frac{dx}{dt} = 2\\text{ units s}^{-1}$:\n$$\\frac{dy}{dt} = -\\frac{15}{2} \\times 2 = -15\\text{ units s}^{-1}$$"
      ]
    }
