      "walkthrough": [
        "$\\overrightarrow{CB}=3\\overrightarrow{OA}=3(2,-2,-1)=(6,-6,-3)$.",
        "$\\overrightarrow{OC}=\\overrightarrow{OB}-\\overrightarrow{CB}=(6,1,1)-(6,-6,-3)=(0,7,4)$."
