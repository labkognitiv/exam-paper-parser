      "hints": [
        "Find $\\overrightarrow{CX}=\\overrightarrow{OX}-\\overrightarrow{OC}$.",
        "Its dot product with $\\overrightarrow{AX}$ establishes perpendicularity."
      ],
      "walkthrough": [
        "$\\overrightarrow{CX}=(-2,-2,5)-(1,-8,3)=(-3,6,2)$.",
        "$\\overrightarrow{CX}\\cdot\\overrightarrow{AX}=(-3)(6)+6(2)+2(3)=-18+12+6=0$, so $CX\\perp AX$."
      ]
