  "questions": [
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq01",
      "sequence": 1,
      "type": "structured",
      "marks": 3,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq01_p01",
          "label": "",
          "marks": 3,
          "answer": "$2r+\\dfrac{2A}{r}$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq01_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "If the angle is $\\theta$, then $A=\\frac12((2r)^2-r^2)\\theta=\\frac32r^2\\theta$, so $\\theta=2A/(3r^2)$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq01_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "The perimeter is $2r\\theta+r\\theta+2(2r-r)=3r\\theta+2r$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq01_p01_mp03",
              "mark_type": "A1",
              "marks": 1,
              "text": "Substitution gives $3r(2A/(3r^2))+2r=2A/r+2r$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq02",
      "sequence": 2,
      "type": "structured",
      "marks": 3,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq02_p01",
          "label": "",
          "marks": 3,
          "answer": "$2r(\\theta+\\sin\\theta)$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq02_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "The minor arc has length $r(2\\theta)=2r\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq02_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "Bisecting isosceles triangle $OAB$ gives $AB=2r\\sin\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq02_p01_mp03",
              "mark_type": "A1",
              "marks": 1,
              "text": "Therefore the segment perimeter is $2r\\theta+2r\\sin\\theta=2r(\\theta+\\sin\\theta)$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq03",
      "sequence": 3,
      "type": "structured",
      "marks": 4,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq03_p01",
          "label": "",
          "marks": 4,
          "answer": "$r^2(2\\sin2\\theta-\\theta)$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq03_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "Triangle area $=\\frac12(2r)(2r)\\sin(2\\theta)=2r^2\\sin2\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq03_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "The inner sector area is $\\frac12r^2(2\\theta)=r^2\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq03_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "Thus the required area is $2r^2\\sin2\\theta-r^2\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq03_p01_mp04",
              "mark_type": "A1",
              "marks": 1,
              "text": "Factoring gives $r^2(2\\sin2\\theta-\\theta)$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq04",
      "sequence": 4,
      "type": "structured",
      "marks": 4,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq04_p01",
          "label": "",
          "marks": 4,
          "answer": "$r^2(\\pi-\\alpha+\\sin\\alpha\\cos\\alpha)$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq04_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "The minor sector area is $r^2\\alpha$ and triangle $OAB$ has area $\\frac12r^2\\sin2\\alpha$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq04_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "Minor segment area $=r^2\\alpha-\\frac12r^2\\sin2\\alpha$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq04_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "Major segment area $=\\pi r^2-r^2\\alpha+\\frac12r^2\\sin2\\alpha$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq04_p01_mp04",
              "mark_type": "A1",
              "marks": 1,
              "text": "Using $\\sin2\\alpha=2\\sin\\alpha\\cos\\alpha$ gives $r^2(\\pi-\\alpha+\\sin\\alpha\\cos\\alpha)$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq05",
      "sequence": 5,
      "type": "structured",
      "marks": 4,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq05_p01",
          "label": "",
          "marks": 4,
          "answer": "$r^2(\\pi-2)$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq05_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "The quarter-circle sector has area $\\frac14\\pi(2r)^2=\\pi r^2$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq05_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "Triangle $ABD$ is right-angled with area $\\frac12(2r)(2r)=2r^2$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq05_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "The segment area is $\\pi r^2-2r^2$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq05_p01_mp04",
              "mark_type": "A1",
              "marks": 1,
              "text": "Therefore the exact area is $r^2(\\pi-2)$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq06",
      "sequence": 6,
      "type": "structured",
      "marks": 5,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01",
          "label": "",
          "marks": 5,
          "answer": "$r^2(\\tan\\theta-\\theta)$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "Since a radius is perpendicular to a tangent, triangles $OAT$ and $OBT$ are right-angled and congruent."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "In triangle $OAT$, $AT=r\\tan\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "Kite area $=2(\\frac12r)(r\\tan\\theta)=r^2\\tan\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01_mp04",
              "mark_type": "M1",
              "marks": 1,
              "text": "Minor-sector area $=\\frac12r^2(2\\theta)=r^2\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq06_p01_mp05",
              "mark_type": "A1",
              "marks": 1,
              "text": "Thus the required area is $r^2(\\tan\\theta-\\theta)$."
            }
          ]
        }
      ]
    },
    {
      "question_id": "9709_p1_t_circular_measure_m06_l02_cpq07",
      "sequence": 7,
      "type": "structured",
      "marks": 5,
      "parts": [
        {
          "part_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01",
          "label": "",
          "marks": 5,
          "answer": "$(\\theta+2)\\sqrt{r^2+\\dfrac{2A}{\\theta}}+(\\theta-2)r$.",
          "accepted_alternatives": [
            "Any algebraically equivalent exact symbolic form."
          ],
          "unit_policy": "No units are required because the variables are abstract and no physical units are specified.",
          "tolerance": "Exact symbolic equivalence required; no numerical tolerance applies.",
          "marking_points": [
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01_mp01",
              "mark_type": "M1",
              "marks": 1,
              "text": "From $A=\\frac12(R^2-r^2)\\theta$, obtain $R^2=r^2+2A/\\theta$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01_mp02",
              "mark_type": "M1",
              "marks": 1,
              "text": "$R>0$, so $R=\\sqrt{r^2+2A/\\theta}$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01_mp03",
              "mark_type": "M1",
              "marks": 1,
              "text": "The perimeter is $R\\theta+r\\theta+2(R-r)$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01_mp04",
              "mark_type": "M1",
              "marks": 1,
              "text": "This is $(\\theta+2)R+(\\theta-2)r$."
            },
            {
              "criterion_id": "9709_p1_t_circular_measure_m06_l02_cpq07_p01_mp05",
              "mark_type": "A1",
              "marks": 1,
              "text": "Substitution gives $(\\theta+2)\\sqrt{r^2+2A/\\theta}+(\\theta-2)r$."
            }
          ]
        }
      ]
    }
