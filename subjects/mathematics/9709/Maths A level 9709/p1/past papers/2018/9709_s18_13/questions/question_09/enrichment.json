      "hints": [
        "Find diagonal $OB$ of the $8$ by $6$ rectangle.",
        "$E$ lies two units along $OB$ from $O$; scale the diagonal vector."
      ],
      "walkthrough": [
        "$OB=\\sqrt{8^2+6^2}=10$ and $\\overrightarrow{OB}=8\\mathbf{i}+6\\mathbf{j}$.",
        "$\\overrightarrow{OE}=\\frac{OE}{OB}\\overrightarrow{OB}=\\frac2{10}(8\\mathbf{i}+6\\mathbf{j})=1.6\\mathbf{i}+1.2\\mathbf{j}$."
      ],
