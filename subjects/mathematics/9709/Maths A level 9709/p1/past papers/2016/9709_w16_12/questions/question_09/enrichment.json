      "hints": [
        "Angle $AOB$ is between $\\overrightarrow{OA}$ and $\\overrightarrow{OB}$.",
        "Find their dot product and each modulus before taking $\\cos^{-1}$."
      ],
      "walkthrough": [
        "$\\overrightarrow{OA}\\cdot\\overrightarrow{OB}=2(-2)+(-2)(3)+(-1)(6)=-16$.",
        "$|OA|=3$, $|OB|=7$, so $\\cos\\angle AOB=-\\frac{16}{21}$. Thus $\\angle AOB=139.6^\\circ$ (4 s.f.)."
      ],
