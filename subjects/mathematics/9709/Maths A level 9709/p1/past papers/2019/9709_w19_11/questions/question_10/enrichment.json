      },
      "skills": {
        "primary_skill_id": "9709_p3_skill_testing_vector_line_relationships"
      },
      "hints": [
        "Compare $\\overrightarrow{AB}$ with the opposite side $\\overrightarrow{DC}$.",
        "Parallel sides are scalar multiples; state the resulting quadrilateral property."
      ],
      "walkthrough": [
        "$\\overrightarrow{DC}=\\overrightarrow{OC}-\\overrightarrow{OD}=(4,-2,5)-(2,2,-1)=(2,-4,6)$.",
        "$\\overrightarrow{AB}=(3,-6,9)=\\frac32\\overrightarrow{DC}$, so $AB\\parallel DC$. Hence $ABCD$ is a trapezium."
      ],
      "checking": {
        "mode": "ai",
        "criteria_source": "mark_scheme_structured"
      }
