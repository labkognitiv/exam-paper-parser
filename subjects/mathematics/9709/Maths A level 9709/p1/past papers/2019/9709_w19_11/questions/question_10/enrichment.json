      "hints": [
        "Calculate $\\overrightarrow{AB}$ and $\\overrightarrow{BC}$ by subtracting consecutive positions.",
        "Check whether their dot product is zero."
      ],
      "walkthrough": [
        "$\\overrightarrow{AB}=(2,-3,5)-(-1,3,-4)=(3,-6,9)$ and $\\overrightarrow{BC}=(4,-2,5)-(2,-3,5)=(2,1,0)$.",
        "$\\overrightarrow{AB}\\cdot\\overrightarrow{BC}=3(2)+(-6)(1)+9(0)=0$, so $AB\\perp BC$."
      ],
      "checking": {
        "mode": "ai",
        "criteria_source": "mark_scheme_structured"
      }
